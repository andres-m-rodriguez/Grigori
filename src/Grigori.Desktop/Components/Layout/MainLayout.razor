@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="app-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer"
                       Size="Size.Small" />
        <MudText Typo="Typo.subtitle1" Class="ml-2">Grigori</MudText>
        <MudSpacer />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="0"
               Variant="DrawerVariant.Mini"
               OpenMiniOnHover="true"
               ClipMode="DrawerClipMode.Always"
               Class="drawer">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Home">Home</MudNavLink>
            <MudNavGroup Title="Context" Icon="@Icons.Material.Outlined.Code" Expanded="true">
                <MudNavLink Href="/context/patterns" Icon="@Icons.Material.Outlined.Pattern">Patterns</MudNavLink>
                <MudNavLink Href="/context/preferences" Icon="@Icons.Material.Outlined.Tune">Preferences</MudNavLink>
                <MudNavLink Href="/context/avoidances" Icon="@Icons.Material.Outlined.Block">Avoidances</MudNavLink>
            </MudNavGroup>
            <MudNavGroup Title="Architecture" Icon="@Icons.Material.Outlined.AccountTree" Expanded="false">
                <MudNavLink Href="/architecture/view" Icon="@Icons.Material.Outlined.Visibility">Overview</MudNavLink>
                <MudNavLink Href="/architecture/patterns" Icon="@Icons.Material.Outlined.Layers">Patterns</MudNavLink>
                <MudNavLink Href="/architecture/templates" Icon="@Icons.Material.Outlined.Code">Templates</MudNavLink>
                <MudNavLink Href="/architecture/naming" Icon="@Icons.Material.Outlined.TextFormat">Naming</MudNavLink>
            </MudNavGroup>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Outlined.Settings">Settings</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="main-content">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = false;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#d97757",
            AppbarBackground = "#1a1a1a",
            Background = "#ffffff",
            Surface = "#f5f5f5",
            DrawerBackground = "#fafafa"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#d97757",
            AppbarBackground = "#1a1a1a",
            Background = "#2b2b2b",
            Surface = "#363636",
            DrawerBackground = "#1a1a1a",
            DrawerText = "#ffffff",
            TextPrimary = "#ffffff"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = ["Inter", "sans-serif"]
            }
        }
    };

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
