@using Grigori.Contracts.Dtos
@using Grigori.Contracts.Interfaces
@inject IArchitectureLayerRepository Repository

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="Name" Label="Name" Required="true" Variant="Variant.Outlined"
                          HelperText="e.g., Presentation, Application, Domain, Infrastructure" />
            <MudTextField @bind-Value="Description" Label="Description" Required="true" Variant="Variant.Outlined" Lines="2" />
            <MudTextField @bind-Value="Responsibility" Label="Responsibility" Required="true" Variant="Variant.Outlined" Lines="2"
                          HelperText="What is this layer responsible for?" />
            <MudTextField @bind-Value="Contains" Label="Contains (optional)" Variant="Variant.Outlined" Lines="2"
                          HelperText="What types of code/classes belong in this layer?" />
            <MudNumericField @bind-Value="Order" Label="Order" Variant="Variant.Outlined"
                             HelperText="Stack position (0 = top layer)" Min="0" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!IsValid)">
            @(IsEdit ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int? Id { get; set; }
    [Parameter] public int PatternId { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Responsibility { get; set; } = "";
    [Parameter] public string? Contains { get; set; }
    [Parameter] public int Order { get; set; }
    [Parameter] public bool IsEdit { get; set; }

    private bool IsValid => !string.IsNullOrWhiteSpace(Name) &&
                            !string.IsNullOrWhiteSpace(Description) &&
                            !string.IsNullOrWhiteSpace(Responsibility);

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (!IsValid) return;

        if (IsEdit && Id.HasValue)
        {
            var dto = new ArchitectureLayerForUpdate(Name, Description, Responsibility, Contains, Order);
            await Repository.UpdateAsync(Id.Value, dto);
        }
        else
        {
            var dto = new ArchitectureLayerForCreate(PatternId, Name, Description, Responsibility, Contains, Order);
            await Repository.CreateAsync(dto);
        }

        MudDialog.Close(DialogResult.Ok(true));
    }
}
