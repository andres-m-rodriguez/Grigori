@page "/architecture/templates"
@using BlazingSingularity.Commands
@using Grigori.Contracts.Dtos
@using Grigori.Contracts.Interfaces
@using Grigori.Contracts.Parameters
@using Grigori.Desktop.Components.Shared
@inject ICodeTemplateRepository Repository
@inject IArchitecturePatternRepository PatternRepository
@inject IDialogService DialogService

<MudText Typo="Typo.h5" Class="mb-4">Code Templates</MudText>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.body2">Reusable code templates for common patterns.</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowAddDialog">Add Template</MudButton>
</MudStack>

@if (LoadDataCommand.IsLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_templates.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Text">No code templates defined yet. Click "Add Template" to create one.</MudAlert>
}
else
{
    <MudTable Items="_templates" Hover="true" Elevation="0" Dense="true" Filter="FilterFunc">
        <ToolBarContent>
            <MudSelect @bind-Value="_categoryFilter" Label="Category" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="mr-4" Style="min-width: 150px;" Clearable="true">
                @foreach (var category in _categories)
                {
                    <MudSelectItem Value="category">@category</MudSelectItem>
                }
            </MudSelect>
            <MudSelect @bind-Value="_languageFilter" Label="Language" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="min-width: 150px;" Clearable="true">
                @foreach (var language in _languages)
                {
                    <MudSelectItem Value="language">@language</MudSelectItem>
                }
            </MudSelect>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Language</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Layer</MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name"><strong>@context.Name</strong></MudTd>
            <MudTd DataLabel="Description">
                <MudTooltip Text="@context.Description">
                    <MudText Typo="Typo.body2" Style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        @context.Description
                    </MudText>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Language"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@context.Language</MudChip></MudTd>
            <MudTd DataLabel="Category"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Category</MudChip></MudTd>
            <MudTd DataLabel="Layer">@(context.LayerName ?? "-")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" OnClick="() => ShowViewDialog(context.Id)" />
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="() => ShowEditDialog(context.Id)" />
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => Delete(context.Id)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<CodeTemplateForList> _templates = [];
    private List<string> _categories = [];
    private List<string> _languages = [];
    private List<ArchitectureLayerForList> _layers = [];
    private string? _categoryFilter;
    private string? _languageFilter;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataCommand.ExecuteAsync();
    }

    [RelayCommand]
    private async Task LoadData()
    {
        _templates = [];
        await foreach (var item in Repository.GetAsync(new CodeTemplateParameters(PageSize: 1000)))
        {
            _templates.Add(item);
        }
        _categories = (await Repository.GetCategoriesAsync()).ToList();
        _languages = (await Repository.GetLanguagesAsync()).ToList();

        var activePattern = await PatternRepository.GetActiveAsync();
        _layers = activePattern?.Layers.ToList() ?? [];
    }

    private bool FilterFunc(CodeTemplateForList template)
    {
        if (!string.IsNullOrWhiteSpace(_categoryFilter) && template.Category != _categoryFilter)
            return false;
        if (!string.IsNullOrWhiteSpace(_languageFilter) && template.Language != _languageFilter)
            return false;
        return true;
    }

    private async Task ShowAddDialog()
    {
        var parameters = new DialogParameters<CodeTemplateDialog>
        {
            { x => x.AvailableLayers, _layers }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CodeTemplateDialog>("Add Template", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataCommand.ExecuteAsync();
        }
    }

    private async Task ShowViewDialog(int id)
    {
        var template = await Repository.GetByIdAsync(id);
        if (template is null) return;

        var parameters = new DialogParameters<CodeTemplateViewDialog>
        {
            { x => x.Template, template }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<CodeTemplateViewDialog>(template.Name, parameters, options);
    }

    private async Task ShowEditDialog(int id)
    {
        var template = await Repository.GetByIdAsync(id);
        if (template is null) return;

        var parameters = new DialogParameters<CodeTemplateDialog>
        {
            { x => x.Id, template.Id },
            { x => x.Name, template.Name },
            { x => x.Description, template.Description },
            { x => x.Language, template.Language },
            { x => x.Category, template.Category },
            { x => x.Template, template.Template },
            { x => x.LayerId, template.LayerId },
            { x => x.AvailableLayers, _layers },
            { x => x.IsEdit, true }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CodeTemplateDialog>("Edit Template", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataCommand.ExecuteAsync();
        }
    }

    private async Task Delete(int id)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "Are you sure you want to delete this template?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Template", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await Repository.DeleteAsync(id);
            await LoadDataCommand.ExecuteAsync();
        }
    }
}
