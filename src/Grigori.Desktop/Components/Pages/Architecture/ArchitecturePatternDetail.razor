@page "/architecture/patterns/{PatternId:int}"
@using BlazingSingularity.Commands
@using Grigori.Contracts.Dtos
@using Grigori.Contracts.Interfaces
@using Grigori.Contracts.Parameters
@using Grigori.Desktop.Components.Shared
@inject IArchitecturePatternRepository PatternRepository
@inject IArchitectureLayerRepository LayerRepository
@inject ILayerDependencyRepository DependencyRepository
@inject IDialogService DialogService
@inject NavigationManager Navigation

@if (LoadDataCommand.IsLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_pattern is null)
{
    <MudAlert Severity="Severity.Error">Pattern not found.</MudAlert>
}
else
{
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" />
            <MudText Typo="Typo.h5">@_pattern.Name</MudText>
            @if (_pattern.IsActive)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Active</MudChip>
            }
        </MudStack>
    </MudStack>

    <MudText Typo="Typo.body2" Class="mb-4">@_pattern.Description</MudText>

    @if (!string.IsNullOrWhiteSpace(_pattern.Diagram))
    {
        <MudExpansionPanels Class="mb-4">
            <MudExpansionPanel Text="Architecture Diagram">
                <pre style="font-family: monospace; white-space: pre; overflow-x: auto; background: var(--mud-palette-surface); padding: 16px; border-radius: 4px;">@_pattern.Diagram</pre>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
        <MudTabPanel Text="Layers">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.body2">Layers in this architecture (ordered from top to bottom).</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowAddLayerDialog">Add Layer</MudButton>
            </MudStack>

            @if (_pattern.Layers.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text">No layers defined. Click "Add Layer" to create one.</MudAlert>
            }
            else
            {
                <MudTable Items="_pattern.Layers.OrderBy(l => l.Order)" Hover="true" Elevation="0" Dense="true">
                    <HeaderContent>
                        <MudTh Style="width: 50px;">Order</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh>Responsibility</MudTh>
                        <MudTh Style="width: 100px;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Order"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Order</MudChip></MudTd>
                        <MudTd DataLabel="Name"><strong>@context.Name</strong></MudTd>
                        <MudTd DataLabel="Description">
                            <MudTooltip Text="@context.Description">
                                <MudText Typo="Typo.body2" Style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @context.Description
                                </MudText>
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Responsibility">
                            <MudTooltip Text="@context.Responsibility">
                                <MudText Typo="Typo.body2" Style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @context.Responsibility
                                </MudText>
                            </MudTooltip>
                        </MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="() => ShowEditLayerDialog(context.Id)" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteLayer(context.Id)" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        <MudTabPanel Text="Dependencies">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.body2">Define which layers can depend on which other layers.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowAddDependencyDialog" Disabled="_pattern.Layers.Count < 2">Add Dependency</MudButton>
            </MudStack>

            @if (_dependencies.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text">No dependencies defined. Click "Add Dependency" to create one.</MudAlert>
            }
            else
            {
                <MudTable Items="_dependencies" Hover="true" Elevation="0" Dense="true">
                    <HeaderContent>
                        <MudTh>Source Layer</MudTh>
                        <MudTh></MudTh>
                        <MudTh>Target Layer</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh Style="width: 100px;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Source">@context.SourceLayerName</MudTd>
                        <MudTd>
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                        </MudTd>
                        <MudTd DataLabel="Target">@context.TargetLayerName</MudTd>
                        <MudTd DataLabel="Status">
                            @if (context.IsAllowed)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Allowed</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Forbidden</MudChip>
                            }
                        </MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="() => ShowEditDependencyDialog(context.Id)" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteDependency(context.Id)" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public int PatternId { get; set; }

    private ArchitecturePatternForDetail? _pattern;
    private List<LayerDependencyForList> _dependencies = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataCommand.ExecuteAsync();
    }

    [RelayCommand]
    private async Task LoadData()
    {
        _pattern = await PatternRepository.GetByIdAsync(PatternId);
        if (_pattern is not null)
        {
            _dependencies = [];
            await foreach (var item in DependencyRepository.GetAsync(new LayerDependencyParameters(PageSize: 1000, PatternId: PatternId)))
            {
                _dependencies.Add(item);
            }
        }
    }

    private void GoBack() => Navigation.NavigateTo("/architecture/patterns");

    private async Task ShowAddLayerDialog()
    {
        var nextOrder = _pattern?.Layers.Count ?? 0;
        var parameters = new DialogParameters<ArchitectureLayerDialog>
        {
            { x => x.PatternId, PatternId },
            { x => x.Order, nextOrder }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ArchitectureLayerDialog>("Add Layer", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataCommand.ExecuteAsync();
        }
    }

    private async Task ShowEditLayerDialog(int id)
    {
        var layer = await LayerRepository.GetByIdAsync(id);
        if (layer is null) return;

        var parameters = new DialogParameters<ArchitectureLayerDialog>
        {
            { x => x.Id, layer.Id },
            { x => x.PatternId, layer.PatternId },
            { x => x.Name, layer.Name },
            { x => x.Description, layer.Description },
            { x => x.Responsibility, layer.Responsibility },
            { x => x.Contains, layer.Contains },
            { x => x.Order, layer.Order },
            { x => x.IsEdit, true }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ArchitectureLayerDialog>("Edit Layer", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataCommand.ExecuteAsync();
        }
    }

    private async Task DeleteLayer(int id)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "Are you sure you want to delete this layer?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Layer", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LayerRepository.DeleteAsync(id);
            await LoadDataCommand.ExecuteAsync();
        }
    }

    private async Task ShowAddDependencyDialog()
    {
        var parameters = new DialogParameters<LayerDependencyDialog>
        {
            { x => x.AvailableLayers, _pattern?.Layers.ToList() ?? [] }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<LayerDependencyDialog>("Add Dependency", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataCommand.ExecuteAsync();
        }
    }

    private async Task ShowEditDependencyDialog(int id)
    {
        var dependency = await DependencyRepository.GetByIdAsync(id);
        if (dependency is null) return;

        var parameters = new DialogParameters<LayerDependencyDialog>
        {
            { x => x.Id, dependency.Id },
            { x => x.SourceLayerId, dependency.SourceLayerId },
            { x => x.TargetLayerId, dependency.TargetLayerId },
            { x => x.IsAllowed, dependency.IsAllowed },
            { x => x.Rationale, dependency.Rationale },
            { x => x.AvailableLayers, _pattern?.Layers.ToList() ?? [] },
            { x => x.IsEdit, true }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<LayerDependencyDialog>("Edit Dependency", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataCommand.ExecuteAsync();
        }
    }

    private async Task DeleteDependency(int id)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "Are you sure you want to delete this dependency?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Dependency", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await DependencyRepository.DeleteAsync(id);
            await LoadDataCommand.ExecuteAsync();
        }
    }
}
