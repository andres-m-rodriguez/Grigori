@page "/architecture/patterns"
@using BlazingSingularity.Commands
@using Grigori.Contracts.Dtos
@using Grigori.Contracts.Interfaces
@using Grigori.Contracts.Parameters
@using Grigori.Desktop.Components.Shared
@inject IArchitecturePatternRepository Repository
@inject IDialogService DialogService
@inject NavigationManager Navigation

<MudText Typo="Typo.h5" Class="mb-4">Architecture Patterns</MudText>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.body2">Define architecture patterns your codebase follows.</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowAddDialog">Add Pattern</MudButton>
</MudStack>

@if (LoadDataCommand.IsLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_patterns.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Text">No architecture patterns defined yet. Click "Add Pattern" to create one.</MudAlert>
}
else
{
    <MudTable Items="_patterns" Hover="true" Elevation="0" Dense="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Layers</MudTh>
            <MudTh>Active</MudTh>
            <MudTh Style="width: 150px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">
                <MudLink Href="@($"/architecture/patterns/{context.Id}")">@context.Name</MudLink>
            </MudTd>
            <MudTd DataLabel="Description">
                <MudTooltip Text="@context.Description">
                    <MudText Typo="Typo.body2" Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        @context.Description
                    </MudText>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Layers"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.LayerCount layers</MudChip></MudTd>
            <MudTd DataLabel="Active">
                @if (context.IsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Active</MudChip>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Outlined.PlayArrow" Size="Size.Small" Color="Color.Default" OnClick="() => SetActive(context.Id)" Title="Set as Active" />
                }
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="() => ShowEditDialog(context.Id)" />
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => Delete(context.Id)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<ArchitecturePatternForList> _patterns = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataCommand.ExecuteAsync();
    }

    [RelayCommand]
    private async Task LoadData()
    {
        _patterns = [];
        await foreach (var item in Repository.GetAsync(new ArchitecturePatternParameters(PageSize: 1000)))
        {
            _patterns.Add(item);
        }
    }

    private async Task ShowAddDialog()
    {
        var parameters = new DialogParameters<ArchitecturePatternDialog>();
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ArchitecturePatternDialog>("Add Architecture Pattern", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataCommand.ExecuteAsync();
        }
    }

    private async Task ShowEditDialog(int id)
    {
        var pattern = await Repository.GetByIdAsync(id);
        if (pattern is null) return;

        var parameters = new DialogParameters<ArchitecturePatternDialog>
        {
            { x => x.Id, pattern.Id },
            { x => x.Name, pattern.Name },
            { x => x.Description, pattern.Description },
            { x => x.Diagram, pattern.Diagram },
            { x => x.IsActive, pattern.IsActive },
            { x => x.IsEdit, true }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ArchitecturePatternDialog>("Edit Architecture Pattern", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataCommand.ExecuteAsync();
        }
    }

    private async Task SetActive(int id)
    {
        await Repository.SetActiveAsync(id);
        await LoadDataCommand.ExecuteAsync();
    }

    private async Task Delete(int id)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "Are you sure you want to delete this architecture pattern? This will also delete all its layers." },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Pattern", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await Repository.DeleteAsync(id);
            await LoadDataCommand.ExecuteAsync();
        }
    }
}
