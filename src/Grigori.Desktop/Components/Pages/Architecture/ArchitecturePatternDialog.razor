@using Grigori.Contracts.Dtos
@using Grigori.Contracts.Interfaces
@inject IArchitecturePatternRepository Repository

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="Name" Label="Name" Required="true" Variant="Variant.Outlined"
                          HelperText="e.g., Clean Architecture, Layered Architecture" />
            <MudTextField @bind-Value="Description" Label="Description" Required="true" Variant="Variant.Outlined" Lines="3" />
            <MudTextField @bind-Value="Diagram" Label="Diagram (optional)" Variant="Variant.Outlined" Lines="10"
                          HelperText="ASCII art or text-based diagram of the architecture" Style="font-family: monospace;" />
            @if (IsEdit)
            {
                <MudSwitch @bind-Value="IsActive" Label="Active" Color="Color.Primary" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!IsValid)">
            @(IsEdit ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int? Id { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string? Diagram { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public bool IsEdit { get; set; }

    private bool IsValid => !string.IsNullOrWhiteSpace(Name) &&
                            !string.IsNullOrWhiteSpace(Description);

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (!IsValid) return;

        if (IsEdit && Id.HasValue)
        {
            var dto = new ArchitecturePatternForUpdate(Name, Description, Diagram, IsActive);
            await Repository.UpdateAsync(Id.Value, dto);
        }
        else
        {
            var dto = new ArchitecturePatternForCreate(Name, Description, Diagram);
            await Repository.CreateAsync(dto);
        }

        MudDialog.Close(DialogResult.Ok(true));
    }
}
