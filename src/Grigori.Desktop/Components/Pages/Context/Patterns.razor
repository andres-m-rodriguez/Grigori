@page "/context/patterns"
@using BlazingSingularity.Commands
@using Grigori.Contracts.Dtos
@using Grigori.Contracts.Interfaces
@using Grigori.Contracts.Parameters
@using Grigori.Desktop.Components.Shared
@inject ICodingPatternRepository Repository
@inject IDialogService DialogService

<MudText Typo="Typo.h5" Class="mb-4">Coding Patterns</MudText>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.body2">Define coding patterns you use consistently.</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowAddDialog">Add Pattern</MudButton>
</MudStack>

@if (LoadDataCommand.IsLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_patterns.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Text">No coding patterns defined yet. Click "Add Pattern" to create one.</MudAlert>
}
else
{
    <MudTable Items="_patterns" Hover="true" Elevation="0" Dense="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Active</MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Description">
                <MudTooltip Text="@context.Description">
                    <MudText Typo="Typo.body2" Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        @context.Description
                    </MudText>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Category"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Category</MudChip></MudTd>
            <MudTd DataLabel="Active">
                <MudIcon Icon="@(context.IsActive ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                         Color="@(context.IsActive ? Color.Success : Color.Default)" Size="Size.Small" />
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="() => ShowEditDialog(context.Id)" />
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => Delete(context.Id)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<CodingPatternForList> _patterns = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataCommand.ExecuteAsync();
    }

    [RelayCommand]
    private async Task LoadData()
    {
        _patterns = [];
        await foreach (var item in Repository.GetAsync(new CodingPatternParameters(PageSize: 1000)))
        {
            _patterns.Add(item);
        }
    }

    private async Task ShowAddDialog()
    {
        var parameters = new DialogParameters<PatternDialog>();
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<PatternDialog>("Add Pattern", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataCommand.ExecuteAsync();
        }
    }

    private async Task ShowEditDialog(int id)
    {
        var pattern = await Repository.GetByIdAsync(id);
        if (pattern is null) return;

        var parameters = new DialogParameters<PatternDialog>
        {
            { x => x.Id, pattern.Id },
            { x => x.Name, pattern.Name },
            { x => x.Description, pattern.Description },
            { x => x.Category, pattern.Category },
            { x => x.Example, pattern.Example },
            { x => x.IsActive, pattern.IsActive },
            { x => x.IsEdit, true }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<PatternDialog>("Edit Pattern", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataCommand.ExecuteAsync();
        }
    }

    private async Task Delete(int id)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "Are you sure you want to delete this pattern?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Pattern", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await Repository.DeleteAsync(id);
            await LoadDataCommand.ExecuteAsync();
        }
    }
}
