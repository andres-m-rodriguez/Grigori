@using BlazingSingularity.Commands
@using Grigori.Contracts.Dtos
@using Grigori.Contracts.Interfaces
@using Grigori.Contracts.Parameters
@inject IAvoidanceRuleRepository Repository
@inject IDesignPreferenceRepository PreferenceRepository

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="Name" Label="Name" Required="true" Variant="Variant.Outlined"
                          HelperText="e.g., Service Locator Pattern" />
            <MudTextField @bind-Value="Description" Label="Description" Required="true" Variant="Variant.Outlined" Lines="2"
                          HelperText="Why this should be avoided" />
            <MudTextField @bind-Value="Category" Label="Category" Required="true" Variant="Variant.Outlined"
                          HelperText="e.g., Architecture, Performance, Security" />
            <MudSelect @bind-Value="Severity" Label="Severity" Variant="Variant.Outlined" Required="true">
                <MudSelectItem Value="AvoidanceSeverity.Avoid">Avoid - Prefer alternatives when possible</MudSelectItem>
                <MudSelectItem Value="AvoidanceSeverity.StronglyAvoid">Strongly Avoid - Only use if absolutely necessary</MudSelectItem>
                <MudSelectItem Value="AvoidanceSeverity.Never">Never - Do not use under any circumstances</MudSelectItem>
            </MudSelect>
            <MudSelect @bind-Value="PreferredAlternativeId" Label="Instead, use... (optional)" Variant="Variant.Outlined"
                       Clearable="true" HelperText="Link to a design preference as the recommended alternative">
                @foreach (var pref in _preferences)
                {
                    <MudSelectItem Value="@((int?)pref.Id)">@pref.Preference (@pref.Category)</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!IsValid)">
            @(IsEdit ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int? Id { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Category { get; set; } = "";
    [Parameter] public AvoidanceSeverity Severity { get; set; } = AvoidanceSeverity.Avoid;
    [Parameter] public int? PreferredAlternativeId { get; set; }
    [Parameter] public bool IsEdit { get; set; }

    private List<DesignPreferenceForList> _preferences = [];

    private bool IsValid => !string.IsNullOrWhiteSpace(Name) &&
                            !string.IsNullOrWhiteSpace(Description) &&
                            !string.IsNullOrWhiteSpace(Category);

    protected override async Task OnInitializedAsync()
    {
        await foreach (var item in PreferenceRepository.GetAsync(new DesignPreferenceParameters(PageSize: 1000)))
        {
            _preferences.Add(item);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (!IsValid) return;

        if (IsEdit && Id.HasValue)
        {
            var dto = new AvoidanceRuleForUpdate(Name, Description, Category, Severity, PreferredAlternativeId);
            await Repository.UpdateAsync(Id.Value, dto);
        }
        else
        {
            var dto = new AvoidanceRuleForCreate(Name, Description, Category, Severity, PreferredAlternativeId);
            await Repository.CreateAsync(dto);
        }

        MudDialog.Close(DialogResult.Ok(true));
    }
}
