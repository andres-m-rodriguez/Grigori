@page "/context/preferences"
@using BlazingSingularity.Commands
@using Grigori.Contracts.Dtos
@using Grigori.Contracts.Interfaces
@using Grigori.Contracts.Parameters
@using Grigori.Desktop.Components.Shared
@inject IDesignPreferenceRepository Repository
@inject IDialogService DialogService

<MudText Typo="Typo.h5" Class="mb-4">Design Preferences</MudText>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.body2">Define your design preferences and coding style choices.</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowAddDialog">Add Preference</MudButton>
</MudStack>

@if (LoadDataCommand.IsLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_preferences.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Text">No design preferences defined yet. Click "Add Preference" to create one.</MudAlert>
}
else
{
    <MudTable Items="_preferences" Hover="true" Elevation="0" Dense="true">
        <HeaderContent>
            <MudTh>Preference</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Priority</MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Preference">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2">@context.Preference</MudText>
                    @if (!string.IsNullOrEmpty(context.Rationale))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Rationale</MudText>
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Category"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Category</MudChip></MudTd>
            <MudTd DataLabel="Priority">
                <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(context.Priority)">@context.Priority</MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="() => ShowEditDialog(context.Id)" />
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => Delete(context.Id)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<DesignPreferenceForList> _preferences = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataCommand.ExecuteAsync();
    }

    [RelayCommand]
    private async Task LoadData()
    {
        _preferences = [];
        await foreach (var item in Repository.GetAsync(new DesignPreferenceParameters(PageSize: 1000)))
        {
            _preferences.Add(item);
        }
    }

    private static Color GetPriorityColor(int priority) => priority switch
    {
        >= 8 => Color.Error,
        >= 5 => Color.Warning,
        >= 3 => Color.Info,
        _ => Color.Default
    };

    private async Task ShowAddDialog()
    {
        var parameters = new DialogParameters<PreferenceDialog>();
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<PreferenceDialog>("Add Preference", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataCommand.ExecuteAsync();
        }
    }

    private async Task ShowEditDialog(int id)
    {
        var pref = await Repository.GetByIdAsync(id);
        if (pref is null) return;

        var parameters = new DialogParameters<PreferenceDialog>
        {
            { x => x.Id, pref.Id },
            { x => x.Category, pref.Category },
            { x => x.Preference, pref.Preference },
            { x => x.Rationale, pref.Rationale },
            { x => x.Priority, pref.Priority },
            { x => x.IsEdit, true }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<PreferenceDialog>("Edit Preference", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataCommand.ExecuteAsync();
        }
    }

    private async Task Delete(int id)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "Are you sure you want to delete this preference?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Preference", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await Repository.DeleteAsync(id);
            await LoadDataCommand.ExecuteAsync();
        }
    }
}
