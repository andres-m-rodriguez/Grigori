@page "/context/avoidances"
@using BlazingSingularity.Commands
@using Grigori.Contracts.Dtos
@using Grigori.Contracts.Interfaces
@using Grigori.Contracts.Parameters
@using Grigori.Desktop.Components.Shared
@inject IAvoidanceRuleRepository Repository
@inject IDialogService DialogService

<MudText Typo="Typo.h5" Class="mb-4">Avoidance Rules</MudText>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.body2">Define patterns and practices you want to avoid.</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowAddDialog">Add Rule</MudButton>
</MudStack>

@if (LoadDataCommand.IsLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_avoidances.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Text">No avoidance rules defined yet. Click "Add Rule" to create one.</MudAlert>
}
else
{
    <MudTable Items="_avoidances" Hover="true" Elevation="0" Dense="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Severity</MudTh>
            <MudTh>Instead, use</MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Description">
                <MudTooltip Text="@context.Description">
                    <MudText Typo="Typo.body2" Style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        @context.Description
                    </MudText>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Category"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Category</MudChip></MudTd>
            <MudTd DataLabel="Severity">
                <MudChip T="string" Size="Size.Small" Color="@GetSeverityColor(context.Severity)">@context.Severity</MudChip>
            </MudTd>
            <MudTd DataLabel="Instead">
                @if (context.PreferredAlternative is not null)
                {
                    <MudTooltip Text="@context.PreferredAlternative.Preference">
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Filled.CheckCircle">
                            @TruncateText(context.PreferredAlternative.Preference, 25)
                        </MudChip>
                    </MudTooltip>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                }
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="() => ShowEditDialog(context.Id)" />
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => Delete(context.Id)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<AvoidanceRuleForList> _avoidances = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataCommand.ExecuteAsync();
    }

    [RelayCommand]
    private async Task LoadData()
    {
        _avoidances = [];
        await foreach (var item in Repository.GetAsync(new AvoidanceRuleParameters(PageSize: 1000)))
        {
            _avoidances.Add(item);
        }
    }

    private static Color GetSeverityColor(AvoidanceSeverity severity) => severity switch
    {
        AvoidanceSeverity.Never => Color.Error,
        AvoidanceSeverity.StronglyAvoid => Color.Warning,
        _ => Color.Default
    };

    private static string TruncateText(string text, int maxLength) =>
        text.Length <= maxLength ? text : text[..(maxLength - 3)] + "...";

    private async Task ShowAddDialog()
    {
        var parameters = new DialogParameters<AvoidanceDialog>();
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AvoidanceDialog>("Add Avoidance Rule", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataCommand.ExecuteAsync();
        }
    }

    private async Task ShowEditDialog(int id)
    {
        var rule = await Repository.GetByIdAsync(id);
        if (rule is null) return;

        var parameters = new DialogParameters<AvoidanceDialog>
        {
            { x => x.Id, rule.Id },
            { x => x.Name, rule.Name },
            { x => x.Description, rule.Description },
            { x => x.Category, rule.Category },
            { x => x.Severity, rule.Severity },
            { x => x.PreferredAlternativeId, rule.PreferredAlternativeId },
            { x => x.IsEdit, true }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AvoidanceDialog>("Edit Avoidance Rule", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataCommand.ExecuteAsync();
        }
    }

    private async Task Delete(int id)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "Are you sure you want to delete this rule?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Avoidance Rule", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await Repository.DeleteAsync(id);
            await LoadDataCommand.ExecuteAsync();
        }
    }
}
