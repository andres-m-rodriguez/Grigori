<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Grigori.Api</RootNamespace>

    <!-- Container optimization -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Runtime identifiers for cross-platform builds -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>

    <!-- Trim settings - disabled due to ONNX Runtime reflection usage -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Static web assets for Blazor -->
    <StaticWebAssetsSelfContained>true</StaticWebAssetsSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grigori.Contracts\Grigori.Contracts.csproj" />
    <ProjectReference Include="..\Grigori.Dashboard\Grigori.Dashboard.csproj" />
    <ProjectReference Include="..\Grigori.Database\Grigori.Database.csproj" />
    <ProjectReference Include="..\Grigori.DataAccess\Grigori.DataAccess.csproj" />
    <ProjectReference Include="..\Grigori.Infrastructure\Grigori.Infrastructure.csproj" />
  </ItemGroup>

</Project>
