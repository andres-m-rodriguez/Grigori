@inherits LayoutComponentBase
@inject DashboardService DashboardService
@inject IBrowserViewportService BrowserViewportService
@inject IGitHubService GitHubService
@inject NavigationManager Navigation
@implements IAsyncDisposable
@implements IBrowserViewportObserver
@using Grigori.Contracts.Interfaces

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="gh-layout">
    @* GitHub-style Header *@
    <header class="gh-header">
        <div class="gh-header-left">
            <a href="" class="gh-logo">
                <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Medium" />
                <span>Grigori</span>
            </a>

            <nav class="gh-nav @(_mobileMenuOpen ? "mobile-open" : "")">
                <a href="dashboard" class="gh-nav-link @(IsActive("dashboard") ? "active" : "")">
                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" />
                    <span>Dashboard</span>
                </a>
                <a href="search" class="gh-nav-link @(IsActive("search") ? "active" : "")">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                    <span>Search</span>
                </a>
                <a href="projects" class="gh-nav-link @(IsActive("projects") ? "active" : "")">
                    <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" />
                    <span>Projects</span>
                </a>
                @if (GitHubService.IsAuthenticated)
                {
                    <a href="github/projects" class="gh-nav-link @(IsActive("github") ? "active" : "")">
                        <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small" />
                        <span>GitHub</span>
                    </a>
                }
            </nav>
        </div>

        <div class="gh-header-right">
            <div class="gh-stats-badge">
                <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" />
                <span>@_totalChunks.ToString("N0")</span>
            </div>

            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem Href="dependencies" Icon="@Icons.Material.Filled.Extension">Dependencies</MudMenuItem>
                <MudMenuItem Href="tools/cli" Icon="@Icons.Material.Filled.Terminal">CLI</MudMenuItem>
                <MudDivider />
                <MudMenuItem Href="integrations/github" Icon="@Icons.Custom.Brands.GitHub">Settings</MudMenuItem>
            </MudMenu>

            <button class="gh-mobile-toggle" @onclick="ToggleMobileMenu">
                <MudIcon Icon="@(_mobileMenuOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Menu)" />
            </button>
        </div>
    </header>

    @* Main Content *@
    <main class="gh-main">
        <div class="gh-container">
            @Body
        </div>
    </main>
</div>

@code {
    private bool _mobileMenuOpen = false;
    private bool _isMobile = false;
    private int _totalChunks = 0;

    // IBrowserViewportObserver implementation
    public Guid Id { get; } = Guid.NewGuid();

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#2f81f7",
            Secondary = "#238636",
            Tertiary = "#a371f7",
            Info = "#58a6ff",
            Success = "#3fb950",
            Warning = "#d29922",
            Error = "#f85149",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#2f81f7",
            Secondary = "#238636",
            Tertiary = "#a371f7",
            Info = "#58a6ff",
            Success = "#3fb950",
            Warning = "#d29922",
            Error = "#f85149",
            Surface = "#161b22",
            Background = "#0d1117",
            BackgroundGray = "#161b22",
            Dark = "#010409",
            DarkLighten = "#21262d",
            DrawerBackground = "#161b22",
            AppbarBackground = "#010409",
            TextPrimary = "#e6edf3",
            TextSecondary = "#8b949e",
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Noto Sans", "Helvetica", "Arial", "sans-serif" }
            }
        }
    };

    private bool IsActive(string path)
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        return uri.StartsWith(path.ToLower());
    }

    private void ToggleMobileMenu() => _mobileMenuOpen = !_mobileMenuOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await BrowserViewportService.SubscribeAsync(this, fireImmediately: true);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    // IBrowserViewportObserver callback
    public async Task NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs args)
    {
        _isMobile = args.Breakpoint < Breakpoint.Md;
        if (!_isMobile && _mobileMenuOpen)
        {
            _mobileMenuOpen = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        var stats = await DashboardService.GetIndexStatsAsync();
        _totalChunks = stats?.TotalChunks ?? 0;

        GitHubService.AuthStateChanged += OnAuthStateChanged;
    }

    private async void OnAuthStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        await BrowserViewportService.UnsubscribeAsync(this);
        GitHubService.AuthStateChanged -= OnAuthStateChanged;
    }
}
