@page "/"
@inject NavigationManager Navigation

<PageTitle>Grigori - Semantic Code Search</PageTitle>

<div class="gh-hero">
    <div class="gh-hero-icon">
        <MudIcon Icon="@Icons.Material.Filled.Hub" Style="font-size: inherit;" />
    </div>

    <h1 class="gh-hero-title">Grigori</h1>
    <p class="gh-hero-subtitle">Semantic Code Search Engine</p>

    <p class="gh-hero-text">
        Index your codebases and search semantically using natural language.
        Find code by meaning, not just keywords.
    </p>

    <div class="gh-hero-actions">
        <a href="search" class="gh-btn gh-btn-primary" style="padding: 10px 24px; font-size: 16px;">
            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
            Start Searching
        </a>
        <a href="dashboard" class="gh-btn" style="padding: 10px 24px; font-size: 16px;">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" />
            View Dashboard
        </a>
    </div>

    <div class="gh-feature-grid">
        <div class="gh-feature-card">
            <div class="gh-feature-icon">
                <MudIcon Icon="@Icons.Material.Filled.Psychology" Style="font-size: inherit;" />
            </div>
            <div class="gh-feature-title">Semantic Search</div>
            <div class="gh-feature-text">Search by intent, not exact matches</div>
        </div>
        <div class="gh-feature-card">
            <div class="gh-feature-icon">
                <MudIcon Icon="@Icons.Material.Filled.Speed" Style="font-size: inherit;" />
            </div>
            <div class="gh-feature-title">HNSW Indexing</div>
            <div class="gh-feature-text">Fast approximate nearest neighbor search</div>
        </div>
        <div class="gh-feature-card">
            <div class="gh-feature-icon">
                <MudIcon Icon="@Icons.Material.Filled.FolderCopy" Style="font-size: inherit;" />
            </div>
            <div class="gh-feature-title">Multi-Project</div>
            <div class="gh-feature-text">Index and search across multiple codebases</div>
        </div>
    </div>
</div>
