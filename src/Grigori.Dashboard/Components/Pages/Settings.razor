@page "/integrations/github"
@using Grigori.Contracts.Dtos.GitHub
@using Grigori.Contracts.Interfaces
@inject IGitHubService GitHubService
@inject ISnackbar Snackbar

<PageTitle>Settings - Grigori</PageTitle>

<div class="gh-page-header">
    <div>
        <h1 class="gh-page-title">Settings</h1>
        <p class="gh-page-subtitle">Configure integrations and preferences</p>
    </div>
</div>

<div class="gh-two-col">
    @* GitHub Integration Panel *@
    <div class="gh-settings-panel">
        <div class="gh-settings-header" style="display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: var(--space-2);">
                <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small" />
                <span class="gh-settings-title">GitHub Integration</span>
            </div>
            @if (GitHubService.IsAuthenticated)
            {
                <span class="gh-label success">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                    Connected
                </span>
            }
            else
            {
                <span class="gh-label">
                    <MudIcon Icon="@Icons.Material.Filled.LinkOff" Size="Size.Small" />
                    Not Connected
                </span>
            }
        </div>
        <div class="gh-settings-body">
            @if (GitHubService.IsAuthenticated && _user != null)
            {
                <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); padding: var(--space-3); background: var(--color-canvas-default); border-radius: var(--radius-2);">
                    <MudAvatar Size="Size.Large" Style="width: 48px; height: 48px;">
                        <MudImage Src="@_user.AvatarUrl" Alt="@_user.Login" Style="width: 100%; height: 100%; object-fit: cover;" />
                    </MudAvatar>
                    <div>
                        <div style="font-weight: 600;">@(_user.Name ?? _user.Login)</div>
                        <div class="text-muted">@@@_user.Login</div>
                        <div style="margin-top: 4px; display: flex; gap: var(--space-2);">
                            <span class="gh-label">@_user.PublicRepos public repos</span>
                            @if (_user.PrivateRepos > 0)
                            {
                                <span class="gh-label">@_user.PrivateRepos private repos</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="gh-alert success" style="margin-bottom: var(--space-3);">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="margin-right: 8px;" />
                    Your GitHub account is connected. Activity features are now available.
                </div>

                <button class="gh-btn" style="color: var(--color-danger-fg);" @onclick="DisconnectGitHub" disabled="@_loading">
                    <MudIcon Icon="@Icons.Material.Filled.LinkOff" Size="Size.Small" />
                    Disconnect
                </button>
            }
            else
            {
                <div class="gh-alert info" style="margin-bottom: var(--space-3);">
                    <div style="margin-bottom: var(--space-2);">
                        To enable GitHub features, create a Personal Access Token (PAT) with these scopes:
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px; padding-left: var(--space-2);">
                        <span><code>repo</code> - Access repositories</span>
                        <span><code>read:user</code> - Read user profile</span>
                    </div>
                </div>

                <div style="margin-bottom: var(--space-3);">
                    <label class="text-muted" style="display: block; margin-bottom: 6px; font-size: 12px;">Personal Access Token</label>
                    <div style="display: flex; gap: var(--space-2);">
                        <input type="@(_showToken ? "text" : "password")"
                               class="gh-search-input"
                               placeholder="ghp_xxxxxxxxxxxxxxxxxxxx"
                               @bind="_tokenInput"
                               style="flex: 1;" />
                        <button class="gh-btn" @onclick="() => _showToken = !_showToken">
                            <MudIcon Icon="@(_showToken ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" Size="Size.Small" />
                        </button>
                    </div>
                    <span class="text-subtle" style="font-size: 12px; margin-top: 4px; display: block;">Your token is stored securely on your machine</span>
                </div>

                <div style="display: flex; gap: var(--space-2);">
                    <button class="gh-btn gh-btn-primary" @onclick="ConnectGitHub" disabled="@(_loading || string.IsNullOrWhiteSpace(_tokenInput))">
                        @if (_loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="width: 16px; height: 16px;" />
                            <span>Connecting...</span>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" />
                            <span>Connect</span>
                        }
                    </button>

                    <a href="https://github.com/settings/tokens/new?description=Grigori&scopes=repo,read:user" target="_blank" class="gh-btn">
                        <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                        Create Token
                    </a>
                </div>
            }
        </div>
    </div>

    @* Features Panel *@
    <div class="gh-settings-panel">
        <div class="gh-settings-header">
            <span class="gh-settings-title">Features</span>
        </div>
        <div class="gh-settings-body" style="padding: 0;">
            <div class="gh-list" style="border: none; border-radius: 0;">
                <div class="gh-list-item">
                    <div class="gh-list-item-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Timeline" Style="color: var(--color-accent-fg);" />
                    </div>
                    <div class="gh-list-item-content">
                        <div style="font-weight: 500;">Activity Feed</div>
                        <div class="gh-list-item-meta">Recent commits, PRs, and branch activity</div>
                    </div>
                    <div class="gh-list-item-actions">
                        @if (GitHubService.IsAuthenticated)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color: var(--color-success-fg);" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Style="color: var(--color-fg-subtle);" />
                        }
                    </div>
                </div>
                <div class="gh-list-item">
                    <div class="gh-list-item-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Whatshot" Style="color: var(--color-attention-fg);" />
                    </div>
                    <div class="gh-list-item-content">
                        <div style="font-weight: 500;">Hot Spots</div>
                        <div class="gh-list-item-meta">Most frequently changed files</div>
                    </div>
                    <div class="gh-list-item-actions">
                        @if (GitHubService.IsAuthenticated)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color: var(--color-success-fg);" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Style="color: var(--color-fg-subtle);" />
                        }
                    </div>
                </div>
                <div class="gh-list-item">
                    <div class="gh-list-item-icon">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Style="color: var(--color-done-fg);" />
                    </div>
                    <div class="gh-list-item-content">
                        <div style="font-weight: 500;">AI Summaries</div>
                        <div class="gh-list-item-meta">LLM-powered change summaries</div>
                    </div>
                    <div class="gh-list-item-actions">
                        <span class="gh-label accent">Coming Soon</span>
                    </div>
                </div>
                <div class="gh-list-item">
                    <div class="gh-list-item-icon">
                        <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Style="color: var(--color-danger-fg);" />
                    </div>
                    <div class="gh-list-item-content">
                        <div style="font-weight: 500;">Project Pulse</div>
                        <div class="gh-list-item-meta">Health and activity indicators</div>
                    </div>
                    <div class="gh-list-item-actions">
                        @if (GitHubService.IsAuthenticated)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color: var(--color-success-fg);" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Style="color: var(--color-fg-subtle);" />
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _tokenInput = "";
    private bool _showToken = false;
    private bool _loading = false;
    private GitHubUserDto? _user;

    protected override async Task OnInitializedAsync()
    {
        if (GitHubService.IsAuthenticated)
        {
            _user = await GitHubService.GetCurrentUserAsync();
        }

        GitHubService.AuthStateChanged += OnAuthStateChanged;
    }

    private async void OnAuthStateChanged()
    {
        if (GitHubService.IsAuthenticated)
        {
            _user = await GitHubService.GetCurrentUserAsync();
        }
        else
        {
            _user = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConnectGitHub()
    {
        if (string.IsNullOrWhiteSpace(_tokenInput))
            return;

        _loading = true;
        StateHasChanged();

        try
        {
            var result = await GitHubService.ConfigureTokenAsync(_tokenInput);

            if (result.Success)
            {
                _user = result.User;
                _tokenInput = "";
                Snackbar.Add($"Connected as {result.User?.Login}", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Failed to connect", Severity.Error);
            }
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void DisconnectGitHub()
    {
        GitHubService.ClearToken();
        _user = null;
        Snackbar.Add("GitHub disconnected", Severity.Info);
    }

    public void Dispose()
    {
        GitHubService.AuthStateChanged -= OnAuthStateChanged;
    }
}
