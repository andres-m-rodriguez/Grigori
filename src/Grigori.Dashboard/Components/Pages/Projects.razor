@page "/projects"
@using Grigori.Contracts.Dtos.Dashboard
@inject DashboardService DashboardService

<PageTitle>Projects - Grigori</PageTitle>

<div class="gh-page-header">
    <div>
        <h1 class="gh-page-title">Projects</h1>
        <p class="gh-page-subtitle">Indexed codebases in your local Grigori instance</p>
    </div>
    <span class="gh-counter" style="font-size: 14px; padding: 4px 12px;">@_projects.Count</span>
</div>

@if (_loading)
{
    <div class="gh-loading">
        <MudProgressCircular Indeterminate="true" Size="Size.Medium" />
    </div>
}
else if (_projects.Count == 0)
{
    <div class="gh-empty-state">
        <div class="gh-empty-state-icon">
            <MudIcon Icon="@Icons.Material.Filled.FolderOff" Style="font-size: inherit;" />
        </div>
        <div class="gh-empty-state-title">No projects indexed yet</div>
        <div class="gh-empty-state-text">
            Use the MCP tool <code>index_directory</code> or the REST API to index a codebase.
        </div>
    </div>
}
else
{
    <div class="gh-list">
        <div class="gh-list-header">
            <div style="flex: 1;">Name</div>
            <div style="width: 100px; text-align: right;">Files</div>
            <div style="width: 100px; text-align: right;">Chunks</div>
            <div style="width: 200px; text-align: right;">Last Indexed</div>
        </div>
        @foreach (var project in _projects)
        {
            <div class="gh-list-item">
                <div class="gh-list-item-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Folder" Style="color: var(--color-attention-fg);" />
                </div>
                <div class="gh-list-item-content" style="flex: 1;">
                    <div class="gh-list-item-title">@project.Name</div>
                    <div class="gh-list-item-meta">
                        <span class="text-mono">@project.Path</span>
                    </div>
                    <div style="margin-top: 4px;">
                        <span class="gh-label purple" style="font-size: 11px;">@project.ExtensionsSummary</span>
                    </div>
                </div>
                <div style="width: 100px; text-align: right;">
                    <span class="text-mono">@project.FileCount.ToString("N0")</span>
                </div>
                <div style="width: 100px; text-align: right;">
                    <span class="text-mono text-accent">@project.ChunkCount.ToString("N0")</span>
                </div>
                <div style="width: 200px; text-align: right;">
                    <span class="text-muted" style="display: flex; align-items: center; justify-content: flex-end; gap: 4px;">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                        @project.FormattedLastIndexed
                    </span>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<IndexedProjectDto> _projects = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _projects = await DashboardService.GetIndexedProjectsAsync();
        }
        finally
        {
            _loading = false;
        }
    }
}
