@page "/dependencies"
@using Grigori.Contracts.Interfaces
@implements IDisposable
@inject IDependencyTracker Tracker

<PageTitle>Dependencies - Grigori</PageTitle>

<div class="gh-page-header">
    <div>
        <h1 class="gh-page-title">Dependencies</h1>
        <p class="gh-page-subtitle">System dependencies and their status</p>
    </div>
    @if (Tracker.AllReady)
    {
        <span class="gh-label success">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
            All Ready
        </span>
    }
    else
    {
        <span class="gh-label warning">
            <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Small" />
            Initializing...
        </span>
    }
</div>

@if (_dependencies.Count == 0)
{
    <div class="gh-alert info">
        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="margin-right: 8px;" />
        No dependencies registered.
    </div>
}
else
{
    <div class="gh-list">
        @foreach (var dep in _dependencies)
        {
            <div class="gh-list-item" style="padding: var(--space-4);">
                <div class="gh-list-item-icon" style="width: 40px; height: 40px;">
                    @switch (dep.State)
                    {
                        case DependencyState.Ready:
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color: var(--color-success-fg);" />
                            break;
                        case DependencyState.Failed:
                            <MudIcon Icon="@Icons.Material.Filled.Error" Style="color: var(--color-danger-fg);" />
                            break;
                        case DependencyState.Downloading:
                        case DependencyState.Loading:
                        case DependencyState.Checking:
                            <MudProgressCircular Size="Size.Small" Indeterminate="@(dep.Progress == null)" Value="@(dep.Progress ?? 0)" Style="color: var(--color-accent-fg);" />
                            break;
                        default:
                            <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Style="color: var(--color-fg-subtle);" />
                            break;
                    }
                </div>
                <div class="gh-list-item-content" style="flex: 1;">
                    <div style="font-weight: 600; margin-bottom: 2px;">@dep.Name</div>
                    <div class="gh-list-item-meta">@dep.Description</div>

                    @if (dep.State is DependencyState.Downloading or DependencyState.Loading or DependencyState.Checking)
                    {
                        <div style="margin-top: var(--space-2);">
                            <MudProgressLinear Value="@(dep.Progress ?? 0)"
                                               Indeterminate="@(dep.Progress == null)"
                                               Color="Color.Primary"
                                               Rounded="true"
                                               Style="height: 4px;" />
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(dep.Message))
                    {
                        <div class="@(dep.State == DependencyState.Failed ? "text-danger" : "text-muted")" style="margin-top: var(--space-1); font-size: 12px;">
                            @dep.Message
                        </div>
                    }
                </div>
                <div class="gh-list-item-actions" style="flex-direction: column; align-items: flex-end; gap: var(--space-1);">
                    <span class="gh-label @GetStateLabelClass(dep.State)">@GetStateText(dep.State)</span>
                    @if (dep.StartedAt.HasValue)
                    {
                        <span class="text-subtle" style="font-size: 11px;">Started @dep.StartedAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
                    }
                    @if (dep.Duration.HasValue)
                    {
                        <span class="text-subtle" style="font-size: 11px;">@FormatDuration(dep.Duration.Value)</span>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<DependencyStatus> _dependencies = [];

    protected override void OnInitialized()
    {
        _dependencies = Tracker.Dependencies.ToList();
        Tracker.OnStatusChanged += OnStatusChanged;
    }

    private void OnStatusChanged(DependencyStatus status)
    {
        InvokeAsync(() =>
        {
            _dependencies = Tracker.Dependencies.ToList();
            StateHasChanged();
        });
    }

    private static string GetStateLabelClass(DependencyState state) => state switch
    {
        DependencyState.Ready => "success",
        DependencyState.Failed => "danger",
        DependencyState.Downloading or DependencyState.Loading or DependencyState.Checking => "accent",
        _ => ""
    };

    private static string GetStateText(DependencyState state) => state switch
    {
        DependencyState.Pending => "Pending",
        DependencyState.Checking => "Checking",
        DependencyState.Downloading => "Downloading",
        DependencyState.Loading => "Loading",
        DependencyState.Ready => "Ready",
        DependencyState.Failed => "Failed",
        _ => "Unknown"
    };

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalSeconds < 1)
            return $"{duration.TotalMilliseconds:F0}ms";
        if (duration.TotalMinutes < 1)
            return $"{duration.TotalSeconds:F1}s";
        return $"{duration.TotalMinutes:F1}m";
    }

    public void Dispose()
    {
        Tracker.OnStatusChanged -= OnStatusChanged;
    }
}
