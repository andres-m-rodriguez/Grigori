@page "/dashboard"
@using Grigori.Contracts.Dtos.Dashboard
@using Grigori.Contracts.Dtos.Metrics
@inject DashboardService DashboardService

<PageTitle>Dashboard - Grigori</PageTitle>

<div class="gh-page-header">
    <div>
        <h1 class="gh-page-title">Dashboard</h1>
        <p class="gh-page-subtitle">Index overview and metrics</p>
    </div>
</div>

@if (_loading)
{
    <div class="gh-loading">
        <MudProgressCircular Indeterminate="true" Size="Size.Medium" />
    </div>
}
else if (_stats != null)
{
    @* Stats Grid *@
    <div class="gh-stats-grid">
        <div class="gh-stat-card">
            <div class="gh-stat-card-icon" style="background: rgba(47, 129, 247, 0.15); color: var(--color-accent-fg);">
                <MudIcon Icon="@Icons.Material.Filled.DataObject" />
            </div>
            <div class="gh-stat-content">
                <div class="gh-stat-value" style="color: var(--color-accent-fg);">@_stats.TotalChunks.ToString("N0")</div>
                <div class="gh-stat-label">Code Chunks</div>
            </div>
        </div>
        <div class="gh-stat-card">
            <div class="gh-stat-card-icon" style="background: rgba(163, 113, 247, 0.15); color: var(--color-done-fg);">
                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" />
            </div>
            <div class="gh-stat-content">
                <div class="gh-stat-value" style="color: var(--color-done-fg);">@_stats.TotalFiles.ToString("N0")</div>
                <div class="gh-stat-label">Files Indexed</div>
            </div>
        </div>
        <div class="gh-stat-card">
            <div class="gh-stat-card-icon" style="background: rgba(210, 153, 34, 0.15); color: var(--color-attention-fg);">
                <MudIcon Icon="@Icons.Material.Filled.Storage" />
            </div>
            <div class="gh-stat-content">
                <div class="gh-stat-value" style="color: var(--color-attention-fg);">@_stats.FormattedSize</div>
                <div class="gh-stat-label">Index Size</div>
            </div>
        </div>
        <div class="gh-stat-card">
            <div class="gh-stat-card-icon" style="background: @(_stats.VectorIndexEnabled ? "rgba(63, 185, 80, 0.15)" : "rgba(110, 118, 129, 0.15)"); color: @(_stats.VectorIndexEnabled ? "var(--color-success-fg)" : "var(--color-fg-muted)");">
                <MudIcon Icon="@(_stats.VectorIndexEnabled ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" />
            </div>
            <div class="gh-stat-content">
                <div class="gh-stat-value" style="color: @(_stats.VectorIndexEnabled ? "var(--color-success-fg)" : "var(--color-fg-muted)");">
                    @(_stats.VectorIndexEnabled ? "Active" : "Inactive")
                </div>
                <div class="gh-stat-label">Vector Index</div>
            </div>
        </div>
    </div>

    @* Status Bar *@
    <div class="gh-box" style="margin-bottom: var(--space-4);">
        <div class="gh-box-body" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-2);">
            <span class="text-muted" style="display: flex; align-items: center; gap: 6px;">
                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                Last Updated: @_stats.FormattedLastUpdated
            </span>
            @if (_stats.VectorIndexEnabled)
            {
                <span class="gh-label success">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                    pgvector: @_stats.VectorCount.ToString("N0") vectors
                </span>
            }
            else
            {
                <span class="gh-label warning">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" />
                    Using linear search
                </span>
            }
        </div>
    </div>

    @* Projects Section *@
    @if (_projects.Count > 0)
    {
        <div class="gh-section">
            <div class="gh-section-header">
                <h2 class="gh-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" />
                    Indexed Projects
                    <span class="gh-counter">@_projects.Count</span>
                </h2>
            </div>

            <div class="gh-project-grid">
                @foreach (var project in _projects)
                {
                    <div class="gh-project-card">
                        <div class="gh-project-card-header">
                            <div class="gh-project-card-icon">
                                <MudIcon Icon="@Icons.Material.Filled.Folder" />
                            </div>
                            <div style="flex: 1; min-width: 0;">
                                <div class="gh-project-name">@project.Name</div>
                                <div class="gh-project-path">@project.Path</div>
                            </div>
                        </div>

                        <div class="gh-project-card-body">
                            <div class="gh-project-stats">
                                <div class="gh-project-stat-box">
                                    <span class="gh-project-stat-value files">@project.FileCount.ToString("N0")</span>
                                    <span class="gh-project-stat-label">Files</span>
                                </div>
                                <div class="gh-project-stat-box">
                                    <span class="gh-project-stat-value chunks">@project.ChunkCount.ToString("N0")</span>
                                    <span class="gh-project-stat-label">Chunks</span>
                                </div>
                            </div>
                        </div>

                        <div class="gh-project-card-footer">
                            <div class="gh-project-extensions">
                                @foreach (var ext in project.ExtensionsSummary.Split(", ").Take(4))
                                {
                                    <span class="gh-project-ext">@ext</span>
                                }
                                @if (project.ExtensionsSummary.Split(", ").Length > 4)
                                {
                                    <span class="gh-project-ext">+@(project.ExtensionsSummary.Split(", ").Length - 4)</span>
                                }
                            </div>
                            <div class="gh-project-time">
                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                @project.FormattedLastIndexed
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* Performance Metrics Chart *@
    @if (_performanceData.Count > 0)
    {
        <div class="gh-section">
            <div class="gh-section-header">
                <h2 class="gh-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Small" />
                    Performance Metrics
                </h2>
            </div>

            <div class="gh-box">
                <div class="gh-box-body">
                    <MudChart ChartType="ChartType.Line"
                              ChartSeries="@_chartSeries"
                              XAxisLabels="@_chartLabels"
                              ChartOptions="@_chartOptions"
                              Height="280px" />
                    <div style="display: flex; justify-content: center; gap: var(--space-3); margin-top: var(--space-3);">
                        <span class="gh-label accent">Search Time (ms)</span>
                        <span class="gh-label success">Index Time (ms)</span>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Activity and Search History *@
    <div class="gh-two-col">
        @* Recent Indexing Activity *@
        <div class="gh-section">
            <div class="gh-section-header">
                <h2 class="gh-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" />
                    Recent Activity
                </h2>
            </div>

            <div class="gh-list">
                @if (_activityLogs.Count == 0)
                {
                    <div class="gh-empty-state" style="padding: var(--space-4);">
                        <div class="text-muted">No indexing activity yet.</div>
                    </div>
                }
                else
                {
                    @foreach (var activity in _activityLogs)
                    {
                        <div class="gh-list-item">
                            <div class="gh-list-item-icon">
                                <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" />
                            </div>
                            <div class="gh-list-item-content">
                                <div style="font-weight: 500;">@activity.Description</div>
                                <div class="gh-list-item-meta">@activity.RelativeTime</div>
                            </div>
                            <div class="gh-list-item-actions">
                                <span class="gh-label">@activity.FormattedDuration</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* Search Query History *@
        <div class="gh-section">
            <div class="gh-section-header">
                <h2 class="gh-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                    Search History
                </h2>
            </div>

            <div class="gh-list">
                @if (_searchHistory.Count == 0)
                {
                    <div class="gh-empty-state" style="padding: var(--space-4);">
                        <div class="text-muted">No search queries yet.</div>
                    </div>
                }
                else
                {
                    @foreach (var search in _searchHistory)
                    {
                        <div class="gh-list-item">
                            <div class="gh-list-item-icon">
                                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                            </div>
                            <div class="gh-list-item-content">
                                <div class="gh-list-item-title" style="color: var(--color-fg-default);">@search.TruncatedQuery</div>
                                <div class="gh-list-item-meta">
                                    @search.RelativeTime
                                    <span style="margin: 0 4px;">·</span>
                                    <span class="@(search.ResultCount > 0 ? "text-success" : "text-warning")">@search.ResultCount results</span>
                                    @if (search.CacheHit)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Cached" Size="Size.Small" Style="margin-left: 4px; color: var(--color-accent-fg);" Title="Cache Hit" />
                                    }
                                </div>
                            </div>
                            <div class="gh-list-item-actions">
                                <span class="gh-label">@search.FormattedDuration</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="gh-alert info">
        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="margin-right: 8px;" />
        No index data available. Index a directory to get started.
    </div>
}

@code {
    private IndexStatsDto? _stats;
    private List<IndexedProjectDto> _projects = [];
    private List<ActivityLogDto> _activityLogs = [];
    private List<SearchHistoryDto> _searchHistory = [];
    private List<PerformanceDataPointDto> _performanceData = [];
    private bool _loading = true;

    // Chart data
    private List<ChartSeries> _chartSeries = [];
    private string[] _chartLabels = [];
    private ChartOptions _chartOptions = new()
    {
        YAxisTicks = 5,
        LineStrokeWidth = 2
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadStatsAsync();
    }

    private async Task LoadStatsAsync()
    {
        _loading = true;
        try
        {
            // Load all data in parallel
            var statsTask = DashboardService.GetIndexStatsAsync();
            var projectsTask = DashboardService.GetIndexedProjectsAsync();
            var activityTask = DashboardService.GetRecentActivityAsync(10);
            var searchHistoryTask = DashboardService.GetSearchHistoryAsync(10);
            var performanceTask = DashboardService.GetPerformanceMetricsAsync(24);

            await Task.WhenAll(statsTask, projectsTask, activityTask, searchHistoryTask, performanceTask);

            _stats = statsTask.Result;
            _projects = projectsTask.Result;
            _activityLogs = activityTask.Result;
            _searchHistory = searchHistoryTask.Result;
            _performanceData = performanceTask.Result;

            // Prepare chart data
            PrepareChartData();
        }
        finally
        {
            _loading = false;
        }
    }

    private void PrepareChartData()
    {
        if (_performanceData.Count == 0)
            return;

        // Show labels every 4 hours to avoid clutter
        _chartLabels = _performanceData.Select((p, i) => i % 4 == 0 ? p.FormattedHour : "").ToArray();

        _chartSeries =
        [
            new ChartSeries
            {
                Name = "Search Time (ms)",
                Data = _performanceData.Select(p => p.AvgSearchTimeMs).ToArray()
            },
            new ChartSeries
            {
                Name = "Index Time (ms)",
                Data = _performanceData.Select(p => p.AvgIndexTimeMs).ToArray()
            }
        ];
    }
}
