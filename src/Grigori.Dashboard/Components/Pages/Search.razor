@page "/search"

<PageTitle>Search - Grigori</PageTitle>

<div class="gh-page-header">
    <div>
        <h1 class="gh-page-title">Code Search</h1>
        <p class="gh-page-subtitle">Search your indexed codebases</p>
    </div>
</div>

@* Search Box *@
<div class="gh-box" style="margin-bottom: var(--space-4);">
    <div class="gh-box-body">
        <div class="gh-search-box" style="margin-bottom: var(--space-3);">
            <input type="text"
                   class="gh-search-input"
                   placeholder="@GetSearchPlaceholder()"
                   @bind="_query"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown" />
            <button class="gh-btn gh-btn-primary" @onclick="() => RunSearchAsync()" disabled="@(_isSearching || string.IsNullOrWhiteSpace(_query))">
                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                Search
            </button>
        </div>

        <div style="display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
            <span class="text-muted">Mode:</span>
            <div class="gh-filter-group">
                <button class="gh-filter-btn @(_searchMode == "hybrid" ? "active" : "")" @onclick="@(() => OnSearchModeChanged("hybrid"))">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Style="vertical-align: middle; margin-right: 4px;" />
                    Hybrid
                </button>
                <button class="gh-filter-btn @(_searchMode == "semantic" ? "active" : "")" @onclick="@(() => OnSearchModeChanged("semantic"))">
                    <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" Style="vertical-align: middle; margin-right: 4px;" />
                    Semantic
                </button>
                <button class="gh-filter-btn @(_searchMode == "lexical" ? "active" : "")" @onclick="@(() => OnSearchModeChanged("lexical"))">
                    <MudIcon Icon="@Icons.Material.Filled.TextFields" Size="Size.Small" Style="vertical-align: middle; margin-right: 4px;" />
                    Lexical
                </button>
            </div>
            <MudTooltip Text="@GetSearchModeTooltip()">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="color: var(--color-fg-subtle); cursor: help;" />
            </MudTooltip>
        </div>
    </div>
</div>

@* Filters *@
@if (_results != null && _results.Count > 0)
{
    <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); flex-wrap: wrap;">
        <span class="text-muted" style="display: flex; align-items: center; gap: 4px;">
            <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" />
            Filters:
        </span>

        <MudSelect T="string"
                   Value="_selectedFileType"
                   ValueChanged="OnFileTypeChanged"
                   Placeholder="File type"
                   Variant="Variant.Outlined"
                   Dense="true"
                   Margin="Margin.Dense"
                   Style="min-width: 120px;"
                   Clearable="true">
            @foreach (var ext in _availableFileTypes.OrderBy(x => x))
            {
                <MudSelectItem Value="@ext">.@ext</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="string"
                   Value="_selectedProject"
                   ValueChanged="OnProjectChanged"
                   Placeholder="Project"
                   Variant="Variant.Outlined"
                   Dense="true"
                   Margin="Margin.Dense"
                   Style="min-width: 150px;"
                   Clearable="true">
            @foreach (var project in _projects)
            {
                <MudSelectItem Value="@project.Name">@project.Name</MudSelectItem>
            }
        </MudSelect>

        @if (!string.IsNullOrEmpty(_selectedFileType) || !string.IsNullOrEmpty(_selectedProject))
        {
            <button class="gh-btn gh-btn-sm" @onclick="ClearFilters">
                <MudIcon Icon="@Icons.Material.Filled.Clear" Size="Size.Small" />
                Clear
            </button>
        }

        <div style="flex: 1;"></div>

        <span class="gh-label">
            <MudIcon Icon="@GetSearchModeIcon()" Size="Size.Small" />
            @_searchMode
        </span>
        <span class="gh-label">
            <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" />
            @_searchDuration.TotalMilliseconds.ToString("F0")ms
        </span>
    </div>
}

@* Loading State *@
@if (_isSearching)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Style="margin-bottom: var(--space-3); border-radius: var(--radius-2);" />
}

@* Results *@
@if (_filteredResults != null)
{
    @if (_filteredResults.Count > 0)
    {
        <div style="margin-bottom: var(--space-3);">
            <span class="text-muted">
                Showing @_filteredResults.Count of @_results?.Count result(s)
                @if (!string.IsNullOrEmpty(_selectedFileType) || !string.IsNullOrEmpty(_selectedProject))
                {
                    <text> (filtered)</text>
                }
            </span>
        </div>

        @foreach (var result in _filteredResults)
        {
            <div class="gh-result-card" @key="@($"{result.FilePath}:{result.StartLine}")">
                <div class="gh-result-header">
                    <div style="display: flex; align-items: center; gap: var(--space-2); min-width: 0; flex: 1;">
                        <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" Style="color: var(--color-fg-muted); flex-shrink: 0;" />
                        <span class="gh-filepath" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            @result.RelativePath
                        </span>
                        <span class="gh-label" style="flex-shrink: 0;">@result.LineRange</span>
                        <span class="gh-label purple" style="flex-shrink: 0;">.@result.FileExtension</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: var(--space-2); flex-shrink: 0;">
                        <span class="gh-result-score">@result.FormattedScore</span>
                        <MudTooltip Text="Copy to clipboard">
                            <button class="gh-btn gh-btn-sm" @onclick="() => CopyToClipboard(result.Content)">
                                <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" />
                            </button>
                        </MudTooltip>
                    </div>
                </div>
                <div class="gh-result-body">
                    <pre class="gh-code"><code class="language-@result.Language">@result.Content</code></pre>
                    <div style="margin-top: var(--space-2); display: flex; align-items: center; gap: var(--space-2);">
                        <span class="gh-label accent">
                            <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" />
                            @result.ProjectName
                        </span>
                        <span class="text-mono text-subtle" style="font-size: 12px;">@result.FilePath</span>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="gh-alert warning">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Small" Style="margin-right: 8px;" />
            @if (_results?.Count > 0)
            {
                <span>No results match the current filters. Try adjusting your filters.</span>
            }
            else
            {
                <span>No results found. Try a different search query.</span>
            }
        </div>
    }
}
else if (!_isSearching)
{
    <div class="gh-empty-state">
        <div class="gh-empty-state-icon">
            <MudIcon Icon="@Icons.Material.Filled.ManageSearch" Style="font-size: inherit;" />
        </div>
        <div class="gh-empty-state-title">Enter a query to search</div>
        <div class="gh-empty-state-text">
            Use natural language to describe what you're looking for
        </div>
        <div style="display: flex; justify-content: center; gap: var(--space-2); margin-top: var(--space-4);">
            <button class="gh-btn gh-btn-sm" @onclick="@(() => SetQueryAndSearch("error handling"))">error handling</button>
            <button class="gh-btn gh-btn-sm" @onclick="@(() => SetQueryAndSearch("database connection"))">database connection</button>
            <button class="gh-btn gh-btn-sm" @onclick="@(() => SetQueryAndSearch("authentication"))">authentication</button>
        </div>
    </div>
}
