@page "/github/projects"
@using Grigori.Contracts.Dtos.GitHub
@using Grigori.Contracts.Interfaces

<PageTitle>GitHub Projects - Grigori</PageTitle>

<div class="gh-page-header">
    <div>
        <h1 class="gh-page-title">GitHub Projects</h1>
        <p class="gh-page-subtitle">Your repositories and activity</p>
    </div>
    @if (GitHubService.IsAuthenticated && _user != null)
    {
        <span class="gh-label success">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
            @_user.Login
        </span>
    }
</div>

<GitHubAuthRequired FeatureDescription="Connect your GitHub account to view your repositories and track activity.">
    @if (_loading)
    {
        <div class="gh-loading">
            <MudProgressCircular Indeterminate="true" Size="Size.Medium" />
        </div>
    }
    else
    {
        @* Filters *@
        <div class="gh-box" style="margin-bottom: var(--space-4);">
            <div class="gh-box-body">
                <div style="display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: flex-end;">
                    <div style="flex: 1; min-width: 200px;">
                        <label class="text-muted" style="display: block; margin-bottom: 6px; font-size: 12px;">Search</label>
                        <input type="text"
                               class="gh-search-input"
                               placeholder="Search repositories..."
                               @bind="_searchQuery"
                               @bind:event="oninput" />
                    </div>
                    <div style="min-width: 150px;">
                        <MudSelect T="string" @bind-Value="_languageFilter"
                                   Placeholder="Language"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true"
                                   Dense="true">
                            @foreach (var lang in Languages)
                            {
                                <MudSelectItem Value="@lang">@lang</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                    <div style="min-width: 120px;">
                        <div class="gh-filter-group">
                            <button class="gh-filter-btn @(_visibilityFilter == "all" ? "active" : "")" @onclick="@(() => _visibilityFilter = "all")">All</button>
                            <button class="gh-filter-btn @(_visibilityFilter == "public" ? "active" : "")" @onclick="@(() => _visibilityFilter = "public")">Public</button>
                            <button class="gh-filter-btn @(_visibilityFilter == "private" ? "active" : "")" @onclick="@(() => _visibilityFilter = "private")">Private</button>
                        </div>
                    </div>
                    <div style="min-width: 150px;">
                        <div class="gh-filter-group">
                            <button class="gh-filter-btn @(_indexFilter == "all" ? "active" : "")" @onclick="@(() => _indexFilter = "all")">All</button>
                            <button class="gh-filter-btn @(_indexFilter == "indexed" ? "active" : "")" @onclick="@(() => _indexFilter = "indexed")">Indexed</button>
                            <button class="gh-filter-btn @(_indexFilter == "not-indexed" ? "active" : "")" @onclick="@(() => _indexFilter = "not-indexed")">Not Indexed</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (FilteredRepositories.Count == 0)
        {
            <div class="gh-empty-state">
                <div class="gh-empty-state-icon">
                    <MudIcon Icon="@Icons.Material.Filled.FolderOff" Style="font-size: inherit;" />
                </div>
                <div class="gh-empty-state-title">No repositories found</div>
                <div class="gh-empty-state-text">No repositories match your current filters.</div>
            </div>
        }
        else
        {
            <div style="margin-bottom: var(--space-3);">
                <span class="text-muted">Showing @PaginatedRepositories.Count of @FilteredRepositories.Count repositories</span>
            </div>

            <div class="gh-project-grid">
                @foreach (var repo in PaginatedRepositories)
                {
                    var status = GetProjectStatus(repo.FullName);
                    var project = GetProject(repo.FullName);
                    var statusDisplay = GetStatusDisplay(status);
                    var isIndexing = IsIndexing(repo.FullName);

                    <div class="gh-project-card" style="cursor: pointer;" @onclick="() => NavigateToProject(repo)">
                        <div class="gh-project-card-header">
                            <div class="gh-project-card-icon" style="@(repo.IsPrivate ? "background: rgba(210, 153, 34, 0.15); color: var(--color-attention-fg);" : "background: rgba(47, 129, 247, 0.15); color: var(--color-accent-fg);")">
                                <MudIcon Icon="@(repo.IsPrivate ? Icons.Material.Filled.Lock : Icons.Material.Filled.Public)" />
                            </div>
                            <div style="flex: 1; min-width: 0;">
                                <div class="gh-project-name">@repo.Name</div>
                                <div class="text-muted" style="font-size: 12px;">@repo.FullName</div>
                            </div>
                            <a href="@repo.HtmlUrl" target="_blank" class="gh-btn gh-btn-sm" @onclick:stopPropagation="true">
                                <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                            </a>
                        </div>

                        <div class="gh-project-card-body">
                            @if (!string.IsNullOrEmpty(repo.Description))
                            {
                                <p class="text-muted" style="font-size: 13px; margin-bottom: var(--space-3); line-height: 1.5;">
                                    @TruncateDescription(repo.Description)
                                </p>
                            }
                            else
                            {
                                <p class="text-subtle" style="font-size: 13px; margin-bottom: var(--space-3); font-style: italic;">
                                    No description
                                </p>
                            }

                            <div class="gh-project-stats">
                                @if (!string.IsNullOrEmpty(repo.Language))
                                {
                                    <div class="gh-project-stat-box" style="padding: 6px 10px;">
                                        <span style="font-size: 12px; font-weight: 500; color: var(--color-accent-fg);">@repo.Language</span>
                                    </div>
                                }
                                <div class="gh-project-stat-box" style="padding: 6px 10px; flex-direction: row; gap: 4px; align-items: center;">
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Style="color: var(--color-attention-fg);" />
                                    <span style="font-size: 12px; font-weight: 500;">@repo.StarCount</span>
                                </div>
                                <div class="gh-project-stat-box" style="padding: 6px 10px; flex-direction: row; gap: 4px; align-items: center;">
                                    <MudIcon Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" Style="color: var(--color-fg-muted);" />
                                    <span style="font-size: 12px; font-weight: 500;">@repo.ForkCount</span>
                                </div>
                            </div>

                            @* Index Status *@
                            <div style="margin-top: var(--space-3); display: flex; align-items: center; gap: var(--space-2);">
                                @if (isIndexing)
                                {
                                    <div style="display: flex; align-items: center; gap: 6px; padding: 4px 10px; background: rgba(210, 153, 34, 0.1); border-radius: 6px;">
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Style="width: 14px; height: 14px;" />
                                        <span style="font-size: 12px; color: var(--color-attention-fg);">Indexing...</span>
                                    </div>
                                }
                                else if (status.HasValue)
                                {
                                    <div style="display: flex; align-items: center; gap: 6px; padding: 4px 10px; background: var(--color-canvas-subtle); border-radius: 6px;">
                                        <MudIcon Icon="@statusDisplay.Icon" Size="Size.Small" Style="@($"color: {statusDisplay.Color}; font-size: 14px;")" />
                                        <span style="font-size: 12px; color: @statusDisplay.Color;">@statusDisplay.Text</span>
                                    </div>
                                    @if (project != null && project.ChunkCount > 0)
                                    {
                                        <span class="text-muted" style="font-size: 11px;">@project.ChunkCount chunks</span>
                                    }
                                }
                            </div>
                        </div>

                        <div class="gh-project-card-footer">
                            <div class="gh-project-time">
                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                Updated @FormatDate(repo.PushedAt ?? repo.UpdatedAt)
                            </div>
                            <div style="display: flex; gap: var(--space-2); align-items: center;">
                                @if (!isIndexing && status != ProjectStatusDto.Indexing)
                                {
                                    <button class="gh-btn gh-btn-sm gh-btn-primary"
                                            @onclick="() => IndexRepositoryAsync(repo)"
                                            @onclick:stopPropagation="true"
                                            title="@(status == ProjectStatusDto.Indexed ? "Re-index repository" : "Index repository")">
                                        <MudIcon Icon="@(status == ProjectStatusDto.Indexed ? Icons.Material.Filled.Refresh : Icons.Material.Filled.CloudDownload)" Size="Size.Small" />
                                        @(status == ProjectStatusDto.Indexed ? "Re-index" : "Index")
                                    </button>
                                }
                                <span class="text-accent" style="font-size: 12px; font-weight: 500;">View Details</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (FilteredRepositories.Count > PageSize)
            {
                <div style="display: flex; justify-content: center; margin-top: var(--space-4);">
                    <MudPagination Count="@TotalPages"
                                   Selected="_currentPage"
                                   SelectedChanged="OnPageChanged"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled" />
                </div>
            }
        }
    }
</GitHubAuthRequired>
