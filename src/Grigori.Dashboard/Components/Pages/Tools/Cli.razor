@page "/tools/cli"

<PageTitle>CLI - Grigori</PageTitle>

<div class="gh-page-header">
    <div>
        <h1 class="gh-page-title">Command Line Interface</h1>
        <p class="gh-page-subtitle">Index your projects to Grigori from the command line</p>
    </div>
</div>

<div class="gh-two-col">
    <div>
        @* Installation *@
        <div class="gh-section">
            <div class="gh-section-header">
                <h2 class="gh-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" />
                    Installation
                </h2>
            </div>
            <div class="gh-box">
                <div class="gh-box-body">
                    <p class="text-muted" style="margin-bottom: var(--space-2);">
                        Install the Grigori CLI as a .NET global tool:
                    </p>
                    <pre class="gh-code" style="margin-bottom: var(--space-2);">dotnet tool install --global Grigori.Cli</pre>
                    <span class="text-subtle" style="font-size: 12px;">Requires .NET 10.0 SDK or later</span>
                </div>
            </div>
        </div>

        @* Usage *@
        <div class="gh-section">
            <div class="gh-section-header">
                <h2 class="gh-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" />
                    Usage
                </h2>
            </div>
            <div class="gh-box">
                <div class="gh-box-body">
                    <pre class="gh-code" style="margin-bottom: var(--space-3);">grigori index [path] [options]</pre>

                    <h3 style="font-size: 14px; font-weight: 600; margin-bottom: var(--space-2);">Arguments</h3>
                    <div class="gh-list" style="margin-bottom: var(--space-3);">
                        <div class="gh-list-item">
                            <code style="min-width: 60px;">path</code>
                            <span class="text-muted" style="margin-left: var(--space-2);">Path to the project directory (default: current directory)</span>
                        </div>
                    </div>

                    <h3 style="font-size: 14px; font-weight: 600; margin-bottom: var(--space-2);">Options</h3>
                    <div class="gh-list">
                        <div class="gh-list-item">
                            <code style="min-width: 180px;">-s, --server &lt;url&gt;</code>
                            <span class="text-muted" style="margin-left: var(--space-2);">Grigori server URL (default: http://localhost:5151)</span>
                        </div>
                        <div class="gh-list-item">
                            <code style="min-width: 180px;">-h, --help</code>
                            <span class="text-muted" style="margin-left: var(--space-2);">Show help information</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Examples *@
        <div class="gh-section">
            <div class="gh-section-header">
                <h2 class="gh-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" />
                    Examples
                </h2>
            </div>
            <div class="gh-box">
                <div class="gh-box-body">
                    <div style="margin-bottom: var(--space-3);">
                        <span class="text-muted" style="display: block; margin-bottom: 6px;">Index the current directory:</span>
                        <pre class="gh-code">grigori index</pre>
                    </div>

                    <div style="margin-bottom: var(--space-3);">
                        <span class="text-muted" style="display: block; margin-bottom: 6px;">Index a specific project:</span>
                        <pre class="gh-code">grigori index ./my-project</pre>
                    </div>

                    <div style="margin-bottom: var(--space-3);">
                        <span class="text-muted" style="display: block; margin-bottom: 6px;">Index to a remote server:</span>
                        <pre class="gh-code">grigori index . -s http://grigori-server:5151</pre>
                    </div>

                    <div>
                        <span class="text-muted" style="display: block; margin-bottom: 6px;">Index from Docker container:</span>
                        <pre class="gh-code">grigori index /mounted/project -s http://host.docker.internal:5151</pre>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div>
        @* Quick Start *@
        <div class="gh-section">
            <div class="gh-section-header">
                <h2 class="gh-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                    Quick Start
                </h2>
            </div>
            <div class="gh-box">
                <div class="gh-box-body">
                    <div class="gh-timeline">
                        <div class="gh-timeline-item">
                            <div style="font-weight: 500;">Start Grigori server</div>
                            <code style="font-size: 12px;">docker run -d -p 5151:5151 grigori</code>
                        </div>
                        <div class="gh-timeline-item">
                            <div style="font-weight: 500;">Install CLI</div>
                            <code style="font-size: 12px;">dotnet tool install -g Grigori.Cli</code>
                        </div>
                        <div class="gh-timeline-item">
                            <div style="font-weight: 500;">Index your project</div>
                            <code style="font-size: 12px;">cd my-project && grigori index</code>
                        </div>
                        <div class="gh-timeline-item success">
                            <div style="font-weight: 500;">Search!</div>
                            <span class="text-muted" style="font-size: 12px;">Use the dashboard or MCP</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Supported Files *@
        <div class="gh-section">
            <div class="gh-section-header">
                <h2 class="gh-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" />
                    Supported Files
                </h2>
            </div>
            <div class="gh-box">
                <div class="gh-box-body">
                    <p class="text-muted" style="margin-bottom: var(--space-3);">
                        The CLI automatically indexes common code files:
                    </p>

                    <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: var(--space-3);">
                        <span class="gh-label purple">.cs</span>
                        <span class="gh-label purple">.ts</span>
                        <span class="gh-label purple">.js</span>
                        <span class="gh-label purple">.py</span>
                        <span class="gh-label purple">.go</span>
                        <span class="gh-label purple">.rs</span>
                        <span class="gh-label purple">.java</span>
                        <span class="gh-label purple">.cpp</span>
                        <span class="gh-label purple">.c</span>
                        <span class="gh-label purple">.razor</span>
                        <span class="gh-label purple">.vue</span>
                        <span class="gh-label purple">.svelte</span>
                    </div>

                    <span class="text-subtle" style="font-size: 12px;">
                        Excludes: node_modules, bin, obj, .git, etc.
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>
