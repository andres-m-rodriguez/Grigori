@page "/search"

<PageTitle>Search - Grigori</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Semantic Search</MudText>

@* Search Input *@
<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudTextField T="string"
                  Value="_query"
                  ValueChanged="OnQueryChanged"
                  Placeholder="Search code semantically... (e.g., 'function that handles user authentication')"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true"
                  OnKeyDown="HandleKeyDown"
                  FullWidth="true"
                  Clearable="true" />
</MudPaper>

@* Filters *@
@if (_results != null && _results.Count > 0)
{
    <MudPaper Elevation="0" Class="pa-3 mb-4" Style="background: var(--mud-palette-background-grey);">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" Class="mr-1" />
                Filters:
            </MudText>

            <MudSelect T="string"
                       Value="_selectedFileType"
                       ValueChanged="OnFileTypeChanged"
                       Label="File Type"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense"
                       Style="min-width: 120px;"
                       Clearable="true">
                @foreach (var ext in _availableFileTypes.OrderBy(x => x))
                {
                    <MudSelectItem Value="@ext">.@ext</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string"
                       Value="_selectedProject"
                       ValueChanged="OnProjectChanged"
                       Label="Project"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense"
                       Style="min-width: 150px;"
                       Clearable="true">
                @foreach (var project in _projects)
                {
                    <MudSelectItem Value="@project.Name">@project.Name</MudSelectItem>
                }
            </MudSelect>

            @if (!string.IsNullOrEmpty(_selectedFileType) || !string.IsNullOrEmpty(_selectedProject))
            {
                <MudButton Size="Size.Small"
                           Variant="Variant.Text"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ClearFilters">
                    Clear
                </MudButton>
            }

            <MudSpacer />

            <MudChip T="string" Icon="@Icons.Material.Filled.Timer" Size="Size.Small" Variant="Variant.Text">
                @_searchDuration.TotalMilliseconds.ToString("F0")ms
            </MudChip>
        </MudStack>
    </MudPaper>
}

@* Loading State *@
@if (_isSearching)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}

@* Results *@
@if (_filteredResults != null)
{
    @if (_filteredResults.Count > 0)
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                Showing @_filteredResults.Count of @_results?.Count result(s)
                @if (!string.IsNullOrEmpty(_selectedFileType) || !string.IsNullOrEmpty(_selectedProject))
                {
                    <text> (filtered)</text>
                }
            </MudText>
        </MudStack>

        <MudStack Spacing="3">
            @foreach (var result in _filteredResults)
            {
                <MudCard Elevation="2" @key="@($"{result.FilePath}:{result.StartLine}")">
                    <MudCardHeader Class="pb-0">
                        <CardHeaderAvatar>
                            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" />
                            </MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body1" Style="font-weight: 600;">
                                    @result.FileName
                                </MudText>
                                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); font-family: monospace;">
                                    @result.RelativePath
                                </MudText>
                            </MudStack>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                                    @result.LineRange
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Text">
                                    .@result.FileExtension
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                    @result.FormattedScore
                                </MudChip>
                            </MudStack>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent Class="pt-2">
                        <div style="position: relative;">
                            <MudTooltip Text="Copy to clipboard">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               Style="position: absolute; top: 8px; right: 8px; z-index: 1;"
                                               OnClick="() => CopyToClipboard(result.Content)" />
                            </MudTooltip>
                            <MudPaper Elevation="0" Class="code-block" Style="background: var(--mud-palette-dark); border-radius: 8px; overflow: hidden;">
                                <pre style="margin: 0; padding: 1rem; padding-right: 3rem; overflow-x: auto;"><code class="language-@result.Language" style="font-family: 'Cascadia Code', 'Fira Code', 'JetBrains Mono', monospace; font-size: 0.8rem; line-height: 1.5;">@result.Content</code></pre>
                            </MudPaper>
                        </div>
                    </MudCardContent>
                    <MudCardActions Class="pt-0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="px-2 pb-2" Style="width: 100%;">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Icon="@Icons.Material.Filled.Folder">
                                @result.ProjectName
                            </MudChip>
                            <MudSpacer />
                            <MudText Typo="Typo.caption" Style="font-family: monospace; color: var(--mud-palette-text-secondary);">
                                @result.FilePath
                            </MudText>
                        </MudStack>
                    </MudCardActions>
                </MudCard>
            }
        </MudStack>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Icon="@Icons.Material.Filled.SearchOff" Variant="Variant.Outlined">
            @if (_results?.Count > 0)
            {
                <MudText>No results match the current filters. Try adjusting your filters.</MudText>
            }
            else
            {
                <MudText>No results found. Try a different search query.</MudText>
            }
        </MudAlert>
    }
}
else if (!_isSearching)
{
    <MudPaper Elevation="0" Class="pa-8 text-center" Style="background: transparent;">
        <MudIcon Icon="@Icons.Material.Filled.ManageSearch" Size="Size.Large" Style="font-size: 4rem; color: var(--mud-palette-primary); opacity: 0.3;" />
        <MudText Typo="Typo.h6" Class="mt-4">Enter a query to search</MudText>
        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
            Use natural language to describe what you're looking for
        </MudText>
        <MudStack Row="true" Justify="Justify.Center" Class="mt-4" Spacing="2">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => OnQueryChanged("error handling"))">error handling</MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => OnQueryChanged("database connection"))">database connection</MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => OnQueryChanged("authentication"))">authentication</MudChip>
        </MudStack>
    </MudPaper>
}
