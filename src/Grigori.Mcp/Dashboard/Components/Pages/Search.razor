@page "/search"

<PageTitle>Search - Grigori</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Semantic Search</MudText>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudStack Row="true" Spacing="2">
        <MudTextField T="string"
                      @bind-Value="_query"
                      Placeholder="Search code semantically... (e.g., 'function that handles user authentication')"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      OnKeyDown="HandleKeyDown"
                      FullWidth="true" />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="() => RunSearchCommand.ExecuteAsync(null)"
                   Disabled="@(!RunSearchCommand.CanExecute(null))"
                   StartIcon="@(RunSearchCommand.IsLoading ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Search)">
            @(RunSearchCommand.IsLoading ? "Searching..." : "Search")
        </MudButton>
    </MudStack>
</MudPaper>

@if (RunSearchCommand.IsLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_results != null)
{
    @if (_results.Count > 0)
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.body1">
                Found @_results.Count result(s)
            </MudText>
            <MudChip T="string" Icon="@Icons.Material.Filled.Timer" Size="Size.Small" Variant="Variant.Text">
                @_searchDuration.TotalMilliseconds.ToString("F0")ms
            </MudChip>
        </MudStack>

        <MudStack Spacing="2">
            @foreach (var result in _results)
            {
                <MudCard Elevation="1">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.body1" Style="font-family: monospace; word-break: break-all;">
                                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-1" />
                                    @result.FilePath
                                </MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                    @result.FormattedScore
                                </MudChip>
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudPaper Elevation="0" Style="background: var(--mud-palette-background); padding: 1rem; border-radius: 4px; overflow-x: auto;">
                            <pre style="margin: 0; font-family: 'Cascadia Code', 'Fira Code', monospace; font-size: 0.85rem; white-space: pre-wrap; word-break: break-word;">@result.Content</pre>
                        </MudPaper>
                        <MudText Typo="Typo.caption" Class="mt-2" Style="color: var(--mud-palette-text-secondary);">
                            <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" Class="mr-1" />
                            @result.LineRange
                        </MudText>
                    </MudCardContent>
                </MudCard>
            }
        </MudStack>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Icon="@Icons.Material.Filled.SearchOff">
            <MudText>No results found. Try a different search query.</MudText>
        </MudAlert>
    }
}
else
{
    <MudPaper Elevation="0" Class="pa-8 text-center" Style="background: transparent;">
        <MudIcon Icon="@Icons.Material.Filled.ManageSearch" Size="Size.Large" Style="font-size: 4rem; opacity: 0.3;" />
        <MudText Typo="Typo.h6" Class="mt-4">Enter a query to search</MudText>
        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
            Use natural language to describe what you're looking for
        </MudText>
    </MudPaper>
}
