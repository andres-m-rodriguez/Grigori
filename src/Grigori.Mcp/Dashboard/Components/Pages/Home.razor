@page "/"
@inject NavigationManager Navigation

<PageTitle>Grigori - Semantic Code Search</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column align-center justify-center" Style="min-height: 60vh;">
    <MudIcon Icon="@Icons.Material.Filled.Hub" Style="font-size: 6rem;" Color="Color.Primary" Class="mb-4" />

    <MudText Typo="Typo.h3" Class="mb-2" Align="Align.Center">Grigori</MudText>
    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mb-6" Align="Align.Center">
        Semantic Code Search Engine
    </MudText>

    <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6" Style="max-width: 500px; color: var(--mud-palette-text-secondary);">
        Index your codebases and search semantically using natural language.
        Find code by meaning, not just keywords.
    </MudText>

    <MudStack Row="true" Spacing="3" Class="mb-8">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Search"
                   Href="search">
            Start Searching
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Dashboard"
                   Href="dashboard">
            View Dashboard
        </MudButton>
    </MudStack>

    <MudGrid Spacing="4" Justify="Justify.Center">
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="0" Class="pa-4 text-center" Style="background: transparent;">
                <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.subtitle1">Semantic Search</MudText>
                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                    Search by intent, not exact matches
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="0" Class="pa-4 text-center" Style="background: transparent;">
                <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.subtitle1">HNSW Indexing</MudText>
                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                    Fast approximate nearest neighbor search
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="0" Class="pa-4 text-center" Style="background: transparent;">
                <MudIcon Icon="@Icons.Material.Filled.FolderCopy" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.subtitle1">Multi-Project</MudText>
                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                    Index and search across multiple codebases
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>
