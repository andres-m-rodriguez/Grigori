@page "/dashboard"
@using Grigori.Contracts.Dtos.Metrics
@inject DashboardService DashboardService

<PageTitle>Dashboard - Grigori</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Index Overview</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_stats != null)
{
    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.overline">Code Chunks</MudText>
                <MudText Typo="Typo.h4" Color="Color.Primary">@_stats.TotalChunks.ToString("N0")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.overline">Files Indexed</MudText>
                <MudText Typo="Typo.h4">@_stats.TotalFiles.ToString("N0")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.overline">Index Size</MudText>
                <MudText Typo="Typo.h4">@_stats.FormattedSize</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.overline">Vector Index</MudText>
                <MudText Typo="Typo.h4" Color="@(_stats.VectorIndexEnabled ? Color.Success : Color.Warning)">
                    @(_stats.VectorIndexEnabled ? "Active" : "Inactive")
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="1" Class="pa-4 mb-6">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.body2">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                    Last Updated: @_stats.FormattedLastUpdated
                </MudText>
            </div>
            <div>
                @if (_stats.VectorIndexEnabled)
                {
                    <MudChip T="string" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small">
                        pgvector: @_stats.VectorCount.ToString("N0") vectors
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small">
                        Using linear search
                    </MudChip>
                }
            </div>
        </MudStack>
    </MudPaper>

    @if (_projects.Count > 0)
    {
        <MudText Typo="Typo.h5" Class="mb-4">Indexed Projects</MudText>
        <MudGrid Spacing="3">
            @foreach (var project in _projects)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="1">
                        <MudCardHeader>
                            <CardHeaderAvatar>
                                <MudIcon Icon="@Icons.Material.Filled.Folder" Color="Color.Primary" />
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@project.Name</MudText>
                                <MudText Typo="Typo.caption" Style="word-break: break-all;">@project.Path</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudStack Row="true" Spacing="4" Class="mb-2">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                    @project.FileCount.ToString("N0") files
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                    @project.ChunkCount.ToString("N0") chunks
                                </MudChip>
                            </MudStack>
                            <MudText Typo="Typo.caption" Class="mb-2" Style="font-family: monospace;">
                                @project.ExtensionsSummary
                            </MudText>
                            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                                @project.FormattedLastIndexed
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

    @* Performance Metrics Chart *@
    @if (_performanceData.Count > 0)
    {
        <MudText Typo="Typo.h5" Class="mb-4 mt-6">Performance Metrics</MudText>
        <MudPaper Elevation="1" Class="pa-4 mb-6">
            <MudChart ChartType="ChartType.Line"
                      ChartSeries="@_chartSeries"
                      XAxisLabels="@_chartLabels"
                      ChartOptions="@_chartOptions"
                      Height="300px" />
            <MudStack Row="true" Justify="Justify.Center" Class="mt-2">
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">Search Time (ms)</MudChip>
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">Index Time (ms)</MudChip>
            </MudStack>
        </MudPaper>
    }

    @* Activity and Search History *@
    <MudGrid Spacing="3" Class="mt-4">
        @* Recent Indexing Activity *@
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.h5" Class="mb-4">Recent Indexing Activity</MudText>
            <MudPaper Elevation="1" Class="pa-4" Style="max-height: 400px; overflow-y: auto;">
                @if (_activityLogs.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No indexing activity yet.</MudAlert>
                }
                else
                {
                    <MudList T="ActivityLogDto" Dense="true">
                        @foreach (var activity in _activityLogs)
                        {
                            <MudListItem T="ActivityLogDto" Icon="@Icons.Material.Filled.Storage">
                                <div class="d-flex justify-space-between align-center" style="width: 100%;">
                                    <div>
                                        <MudText Typo="Typo.body2">@activity.Description</MudText>
                                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                                            @activity.RelativeTime
                                        </MudText>
                                    </div>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                        @activity.FormattedDuration
                                    </MudChip>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>
        </MudItem>

        @* Search Query History *@
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.h5" Class="mb-4">Search Query History</MudText>
            <MudPaper Elevation="1" Class="pa-4" Style="max-height: 400px; overflow-y: auto;">
                @if (_searchHistory.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No search queries yet.</MudAlert>
                }
                else
                {
                    <MudList T="SearchHistoryDto" Dense="true">
                        @foreach (var search in _searchHistory)
                        {
                            <MudListItem T="SearchHistoryDto" Icon="@Icons.Material.Filled.Search">
                                <div class="d-flex justify-space-between align-center" style="width: 100%;">
                                    <div style="flex: 1; min-width: 0;">
                                        <MudText Typo="Typo.body2" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            @search.TruncatedQuery
                                        </MudText>
                                        <MudStack Row="true" Spacing="1">
                                            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                                                @search.RelativeTime
                                            </MudText>
                                            <MudText Typo="Typo.caption">|</MudText>
                                            <MudText Typo="Typo.caption" Color="@(search.ResultCount > 0 ? Color.Success : Color.Warning)">
                                                @search.ResultCount results
                                            </MudText>
                                            @if (search.CacheHit)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Cached" Size="Size.Small" Color="Color.Info" Title="Cache Hit" />
                                            }
                                        </MudStack>
                                    </div>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                        @search.FormattedDuration
                                    </MudChip>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}
else
{
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Info" Class="mt-4">
        <MudText>No index data available. Index a directory to get started.</MudText>
    </MudAlert>
}

@code {
    private IndexStats? _stats;
    private List<IndexedProject> _projects = [];
    private List<ActivityLogDto> _activityLogs = [];
    private List<SearchHistoryDto> _searchHistory = [];
    private List<PerformanceDataPointDto> _performanceData = [];
    private bool _loading = true;

    // Chart data
    private List<ChartSeries> _chartSeries = [];
    private string[] _chartLabels = [];
    private ChartOptions _chartOptions = new()
    {
        YAxisTicks = 5,
        LineStrokeWidth = 2
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadStatsAsync();
    }

    private async Task LoadStatsAsync()
    {
        _loading = true;
        try
        {
            // Load all data in parallel
            var statsTask = DashboardService.GetIndexStatsAsync();
            var projectsTask = DashboardService.GetIndexedProjectsAsync();
            var activityTask = DashboardService.GetRecentActivityAsync(10);
            var searchHistoryTask = DashboardService.GetSearchHistoryAsync(10);
            var performanceTask = DashboardService.GetPerformanceMetricsAsync(24);

            await Task.WhenAll(statsTask, projectsTask, activityTask, searchHistoryTask, performanceTask);

            _stats = statsTask.Result;
            _projects = projectsTask.Result;
            _activityLogs = activityTask.Result;
            _searchHistory = searchHistoryTask.Result;
            _performanceData = performanceTask.Result;

            // Prepare chart data
            PrepareChartData();
        }
        finally
        {
            _loading = false;
        }
    }

    private void PrepareChartData()
    {
        if (_performanceData.Count == 0)
            return;

        // Show labels every 4 hours to avoid clutter
        _chartLabels = _performanceData.Select((p, i) => i % 4 == 0 ? p.FormattedHour : "").ToArray();

        _chartSeries =
        [
            new ChartSeries
            {
                Name = "Search Time (ms)",
                Data = _performanceData.Select(p => p.AvgSearchTimeMs).ToArray()
            },
            new ChartSeries
            {
                Name = "Index Time (ms)",
                Data = _performanceData.Select(p => p.AvgIndexTimeMs).ToArray()
            }
        ];
    }
}
