@page "/github/projects"
@using Grigori.Contracts.Dtos.GitHub
@using Grigori.Contracts.Interfaces
@inject IGitHubService GitHubService

<PageTitle>GitHub Projects - Grigori</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">GitHub Projects</MudText>

<GitHubAuthRequired FeatureDescription="Connect your GitHub account to view your repositories and track activity, hot spots, and project health.">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <MudPaper Elevation="1" Class="pa-0">
                    <MudList T="GitHubRepositoryDto" Dense="true" SelectedValue="_selectedRepo" SelectedValueChanged="OnRepoSelected">
                        <MudListSubheader>
                            <MudText Typo="Typo.subtitle2">Your Repositories</MudText>
                        </MudListSubheader>
                        @foreach (var repo in _repositories)
                        {
                            <MudListItem T="GitHubRepositoryDto" Value="repo">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@(repo.IsPrivate ? Icons.Material.Filled.Lock : Icons.Material.Filled.Public)"
                                             Size="Size.Small"
                                             Color="@(repo.IsPrivate ? Color.Warning : Color.Default)" />
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body2">@repo.Name</MudText>
                                        @if (!string.IsNullOrEmpty(repo.Language))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@repo.Language</MudText>
                                        }
                                    </MudStack>
                                </MudStack>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="8">
                @if (_selectedRepo == null)
                {
                    <MudAlert Severity="Severity.Info">
                        Select a repository to view activity, hot spots, and project pulse.
                    </MudAlert>
                }
                else
                {
                    <MudPaper Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-4">
                            <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Large" />
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.h6">@_selectedRepo.FullName</MudText>
                                @if (!string.IsNullOrEmpty(_selectedRepo.Description))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_selectedRepo.Description</MudText>
                                }
                            </MudStack>
                            <MudSpacer />
                            <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Star" Color="Color.Warning">
                                @_selectedRepo.StarCount
                            </MudChip>
                        </MudStack>

                        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" PanelClass="pa-4">
                            <MudTabPanel Text="Activity" Icon="@Icons.Material.Filled.Timeline">
                                @if (_loadingDetails)
                                {
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                }
                                else
                                {
                                    <MudText Typo="Typo.subtitle1" Class="mb-3">Recent Commits</MudText>
                                    @if (_commits.Count == 0)
                                    {
                                        <MudText Color="Color.Secondary">No recent commits found.</MudText>
                                    }
                                    else
                                    {
                                        <MudList T="GitHubCommitDto" Dense="true">
                                            @foreach (var commit in _commits.Take(10))
                                            {
                                                <MudListItem T="GitHubCommitDto">
                                                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                                        <MudAvatar Size="Size.Small" Color="Color.Primary">
                                                            @(commit.AuthorName?.FirstOrDefault())
                                                        </MudAvatar>
                                                        <MudStack Spacing="0">
                                                            <MudText Typo="Typo.body2">@commit.ShortMessage</MudText>
                                                            <MudStack Row="true" Spacing="1">
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@commit.ShortSha</MudText>
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">by @commit.AuthorName</MudText>
                                                            </MudStack>
                                                        </MudStack>
                                                    </MudStack>
                                                </MudListItem>
                                            }
                                        </MudList>
                                    }

                                    <MudText Typo="Typo.subtitle1" Class="mb-3 mt-4">Pull Requests</MudText>
                                    @if (_pullRequests.Count == 0)
                                    {
                                        <MudText Color="Color.Secondary">No pull requests found.</MudText>
                                    }
                                    else
                                    {
                                        <MudList T="GitHubPullRequestDto" Dense="true">
                                            @foreach (var pr in _pullRequests.Take(5))
                                            {
                                                <MudListItem T="GitHubPullRequestDto">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                        <MudIcon Icon="@Icons.Material.Filled.MergeType"
                                                                 Size="Size.Small"
                                                                 Color="@(pr.State == "open" ? Color.Success : Color.Default)" />
                                                        <MudStack Spacing="0">
                                                            <MudText Typo="Typo.body2">#@pr.Number @pr.Title</MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@pr.HeadBranch → @pr.BaseBranch</MudText>
                                                        </MudStack>
                                                    </MudStack>
                                                </MudListItem>
                                            }
                                        </MudList>
                                    }
                                }
                            </MudTabPanel>

                            <MudTabPanel Text="Hot Spots" Icon="@Icons.Material.Filled.Whatshot">
                                <MudAlert Severity="Severity.Info" Class="mb-4">
                                    Hot spots analysis coming soon. This will show the most frequently changed files.
                                </MudAlert>
                                <MudList T="string" Dense="true">
                                    <MudListItem T="string" Icon="@Icons.Material.Filled.TrendingUp">
                                        Most changed files based on commit history
                                    </MudListItem>
                                    <MudListItem T="string" Icon="@Icons.Material.Filled.BugReport">
                                        Bug-prone areas based on fix commits
                                    </MudListItem>
                                    <MudListItem T="string" Icon="@Icons.Material.Filled.Group">
                                        Collaboration zones with multiple contributors
                                    </MudListItem>
                                </MudList>
                            </MudTabPanel>

                            <MudTabPanel Text="Project Pulse" Icon="@Icons.Material.Filled.MonitorHeart">
                                <MudAlert Severity="Severity.Info" Class="mb-4">
                                    Project pulse metrics coming soon. This will show repository health indicators.
                                </MudAlert>
                                <MudGrid Spacing="3">
                                    <MudItem xs="6" md="3">
                                        <MudPaper Elevation="0" Class="pa-3 text-center">
                                            <MudText Typo="Typo.h4" Color="Color.Primary">@_commits.Count</MudText>
                                            <MudText Typo="Typo.caption">Recent Commits</MudText>
                                        </MudPaper>
                                    </MudItem>
                                    <MudItem xs="6" md="3">
                                        <MudPaper Elevation="0" Class="pa-3 text-center">
                                            <MudText Typo="Typo.h4" Color="Color.Success">@_pullRequests.Count(p => p.State == "open")</MudText>
                                            <MudText Typo="Typo.caption">Open PRs</MudText>
                                        </MudPaper>
                                    </MudItem>
                                    <MudItem xs="6" md="3">
                                        <MudPaper Elevation="0" Class="pa-3 text-center">
                                            <MudText Typo="Typo.h4" Color="Color.Warning">@_selectedRepo.StarCount</MudText>
                                            <MudText Typo="Typo.caption">Stars</MudText>
                                        </MudPaper>
                                    </MudItem>
                                    <MudItem xs="6" md="3">
                                        <MudPaper Elevation="0" Class="pa-3 text-center">
                                            <MudText Typo="Typo.h4" Color="Color.Info">@_selectedRepo.ForkCount</MudText>
                                            <MudText Typo="Typo.caption">Forks</MudText>
                                        </MudPaper>
                                    </MudItem>
                                </MudGrid>
                            </MudTabPanel>
                        </MudTabs>
                    </MudPaper>
                }
            </MudItem>
        </MudGrid>
    }
</GitHubAuthRequired>

@code {
    private bool _loading = true;
    private bool _loadingDetails = false;
    private List<GitHubRepositoryDto> _repositories = [];
    private GitHubRepositoryDto? _selectedRepo;
    private List<GitHubCommitDto> _commits = [];
    private List<GitHubPullRequestDto> _pullRequests = [];

    protected override async Task OnInitializedAsync()
    {
        if (GitHubService.IsAuthenticated)
        {
            await LoadRepositoriesAsync();
        }
    }

    private async Task LoadRepositoriesAsync()
    {
        _loading = true;
        try
        {
            _repositories = await GitHubService.GetRepositoriesAsync(30);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnRepoSelected(GitHubRepositoryDto? repo)
    {
        _selectedRepo = repo;
        if (repo != null)
        {
            await LoadRepoDetailsAsync(repo);
        }
    }

    private async Task LoadRepoDetailsAsync(GitHubRepositoryDto repo)
    {
        _loadingDetails = true;
        StateHasChanged();

        try
        {
            var parts = repo.FullName.Split('/');
            var owner = parts[0];
            var repoName = parts[1];

            var commitsTask = GitHubService.GetRecentCommitsAsync(owner, repoName, 20);
            var prsTask = GitHubService.GetPullRequestsAsync(owner, repoName, 10);

            await Task.WhenAll(commitsTask, prsTask);

            _commits = commitsTask.Result;
            _pullRequests = prsTask.Result;
        }
        finally
        {
            _loadingDetails = false;
        }
    }
}
